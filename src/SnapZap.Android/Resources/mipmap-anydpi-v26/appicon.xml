<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (API 26+). Without this the launcher treats the square PNG as a legacy icon and
  shrinks it inside a system-drawn circle, which is why SnapZap sat as a small badge while Chrome
  and Photos filled theirs. The 108dp canvas is masked to its centre 72dp, so the foreground art
  is drawn at 78% of the canvas: large enough that the mask crops a little of the outer ring
  instead of leaving a gap at the circle's edge.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/appicon_background" />
  <foreground android:drawable="@mipmap/appicon_fg" />
  <monochrome android:drawable="@mipmap/appicon_fg" />
</adaptive-icon>
