@page "/"
@implements IDisposable
@inject AppState AppState
@inject DependencyChecker Checker
@inject SessionStore Session
@inject IJSRuntime JS
@using Scope = SnapZap.App.Services.AppState.SelectionScope

<header class="topbar">
    @* The same artwork as the window and taskbar icon (assets/icon/snapzap.png, resized into
       wwwroot by scripts/make-icons.py). alt is empty on purpose: the wordmark beside it already
       says "SnapZap", and a description here would just make a screen reader say it twice. *@
    <div class="brand">
        <img class="brand-mark" src="snapzap.png" width="26" height="26" alt="" />
        <span>Snap<em>Zap</em></span>
    </div>

    @if (AppState.Images.Count > 0)
    {
        <JumpSearch OnPick="OpenPreview" />
    }

    @if (AppState.ScannedFolder is not null)
    {
        <button class="btn btn-secondary" style="margin-left:@(AppState.Images.Count > 0 ? "0" : "auto")"
                @onclick="OpenUndo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></svg>
            History
        </button>
    }

    <div class="topbar-tools" style="@(AppState.ScannedFolder is null && AppState.Images.Count == 0 ? "margin-left:auto" : "")">
        <button class="icon-btn" title="Recover photos hidden inside a PNG" aria-label="Extract hidden images"
                aria-haspopup="dialog" aria-expanded="@(_showExtract ? "true" : "false")"
                @onclick="OpenExtract">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="8" width="18" height="12" rx="1" /><path d="M7 8V6a5 5 0 0 1 10 0v2" /></svg>
        </button>
        <button class="icon-btn" title="Help and FAQ" aria-label="Help and FAQ"
                aria-haspopup="dialog" aria-expanded="@(_showHelp ? "true" : "false")"
                @onclick="() => OpenHelp(null)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M9.5 9a2.5 2.5 0 113.5 2.3c-.7.4-1 .9-1 1.7" /><circle cx="12" cy="17" r=".6" fill="currentColor" stroke="none" /></svg>
        </button>
        <button class="icon-btn" title="Setup" aria-label="Setup"
                aria-haspopup="dialog" aria-expanded="@(_showSetup ? "true" : "false")"
                @onclick="() => _showSetup = true">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15a3 3 0 100-6 3 3 0 000 6z" /><path d="M19.4 15a1.7 1.7 0 00.3 1.9l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.9-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1A1.7 1.7 0 008.9 19a1.7 1.7 0 00-1.9.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.9 1.7 1.7 0 00-1.5-1H3a2 2 0 110-4h.1A1.7 1.7 0 004.6 8.4a1.7 1.7 0 00-.3-1.9l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.9.3H9a1.7 1.7 0 001-1.5V3a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.9-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.9V9a1.7 1.7 0 001.5 1H21a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z" /></svg>
            @if (Checker.MissingCount > 0)
            {
                <span class="pip" title="@Checker.MissingCount optional feature(s) not installed">@Checker.MissingCount</span>
            }
        </button>
        <button class="icon-btn theme-toggle" title="Switch light/dark theme" aria-label="Switch light/dark theme"
                @onclick="ToggleTheme">
            <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l1.4 1.4M17.6 17.6L19 19M19 5l-1.4 1.4M6.4 17.6L5 19" /></svg>
            <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 119.5 4a7 7 0 1010.5 10.5z" /></svg>
        </button>
    </div>
</header>

@if (AppState.Images.Count == 0 && AppState.ScannedFolder is null && !AppState.Busy)
{
    <FirstRun OnOpenHelp="() => OpenHelp(null)" />
}
else
{
    <main>
        <Rail @ref="_rail" OnOpenDupeReview="OpenDupeReview" />

        <section class="content">
            @* Shared by every long operation that reports progress (Scan, Duplicates, Content
               review) — not just Scan. AppState.BusyDone/BusyTotal/BusyDetail are populated the
               same way by all three (see AppState.RunAsync), so Content review scoring gets the
               same live counter and bar as Scan does, not silent silence while it runs. *@
            @if (AppState.Busy && BusyProgressNoun is { } noun)
            {
                <div class="scan-stats">
                    <div class="scan-count">
                        <b>@AppState.BusyDone.ToString("N0")</b>
                        <span>@(AppState.BusyTotal > 0 ? $"of about {AppState.BusyTotal:N0} {noun}" : noun)</span>
                    </div>
                    <div class="scan-track"><div style="width:@(ScanPercent)%"></div></div>
                    @if (AppState.BusyDetail is { Length: > 0 } current)
                    {
                        <div class="scan-current">@current</div>
                    }
                    @if (AppState.BusyLabel == "Scanning")
                    {
                        <div class="scan-metrics">
                            <div class="scan-metric"><div class="eyeb">Checksums</div><b>@AppState.BusyDone.ToString("N0")</b></div>
                            <div class="scan-metric accent"><div class="eyeb">Reused</div><b>@AppState.BusyCached.ToString("N0")</b></div>
                        </div>
                        <div class="scan-hint">
                            Stopping keeps everything analysed so far — re-scanning picks up where this
                            left off. Duplicate detection starts by itself the moment this finishes.
                        </div>
                    }
                    else if (AppState.BusyLabel == "Moving to the Recycle Bin")
                    {
                        <div class="scan-hint">Every photo already moved is safely in the Recycle Bin and undoable from History — stopping just leaves the rest where they are.</div>
                    }
                    else
                    {
                        <div class="scan-hint">Stopping keeps everything scored so far — re-running picks up where this left off.</div>
                    }
                </div>
            }

            <div class="mhead">
                @if (AppState.Busy)
                {
                    <div style="font-size:13px">@AppState.BusyLabel<text>&hellip; </text><b>@(AppState.ScannedFolder ?? "")</b></div>
                    <button class="btn btn-secondary" style="margin-left:auto" disabled="@(!AppState.CanCancel)" @onclick="() => AppState.Cancel()">
                        @(AppState.CanCancel ? "Stop" : "Stopping…")
                    </button>
                }
                else
                {
                    <div class="mhead-split">
                        <button class="btn @(AppState.HasActiveFilter ? "btn-primary" : "btn-secondary")" style="font-size:12.5px"
                                disabled="@(SelectAllCount == 0)" @onclick="() => AppState.SelectBy(Scope.AllShown)">
                            Select all @SelectAllCount.ToString("N0") shown
                        </button>
                        <button class="btn @(AppState.HasActiveFilter ? "btn-primary" : "btn-secondary")" style="width:26px"
                                aria-haspopup="true" aria-expanded="@(_scopeMenuOpen ? "true" : "false")"
                                @onclick="() => _scopeMenuOpen = !_scopeMenuOpen">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                        </button>
                    </div>

                    @if (_scopeMenuOpen)
                    {
                        <div class="popover" style="position:absolute;top:100px;left:18px;z-index:50;min-width:220px;padding:6px;background:var(--color-bg);border:1px solid var(--color-text)">
                            @foreach (var scope in new[] { Scope.LikelyExplicit, Scope.NotSure, Scope.DuplicateKeepers })
                            {
                                <button class="btn btn-secondary btn-block" style="border:none;font-size:12.5px"
                                        disabled="@(AppState.SelectableCount(scope) == 0)"
                                        @onclick="() => { AppState.SelectBy(scope); _scopeMenuOpen = false; }">
                                    @ScopeLabel(scope)
                                    <span class="btn-count">@AppState.SelectableCount(scope).ToString("N0")</span>
                                </button>
                            }
                        </div>
                        <div style="position:fixed;inset:0;z-index:40" @onclick="() => _scopeMenuOpen = false"></div>
                    }

                    @if (!AppState.HasActiveFilter)
                    {
                        <button class="btn btn-secondary" style="font-size:12.5px" @onclick="() => _rail?.ShowFiltersTab()">
                            Filters
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                        </button>
                    }
                    else
                    {
                        @foreach (var chip in ActiveFilterChips())
                        {
                            <div class="filter-chip">
                                <b>@chip.Label</b>
                                <span class="clear" role="button" tabindex="0" @onclick="chip.Clear">✕</span>
                            </div>
                        }
                        <button class="btn btn-ghost" style="font-size:11.5px" @onclick="() => _rail?.ShowFiltersTab()">Filters</button>
                        <button class="btn btn-ghost" style="font-size:11.5px" @onclick="() => AppState.ClearFilters()">Clear all</button>
                    }

                    <div class="sortbar">
                        <span class="eyeb">Sort</span>
                        <select value="@AppState.Sort" @onchange="SortChanged">
                            <option value="@SortKey.Scanned">Scan order</option>
                            <option value="@SortKey.Captured">Date taken</option>
                            <option value="@SortKey.Name">Name</option>
                            <option value="@SortKey.Size">File size</option>
                            <option value="@SortKey.Blur">Sharpness</option>
                            <option value="@SortKey.Nsfw">Explicit content</option>
                        </select>
                        <button class="btn btn-icon" title="@SortDirLabel" aria-label="@SortDirLabel"
                                @onclick="() => AppState.SortDescending = !AppState.SortDescending">
                            @(AppState.SortDescending ? "↓" : "↑")
                        </button>
                    </div>
                }
            </div>

            @* The result of whatever last ran — including a failure. Without this, an
               exception during Scan/Dedup/NSFW/Forget/Restore re-enabled the button with
               nothing on screen to say what went wrong. *@
            @if (!AppState.Busy && AppState.Status.Length > 0)
            {
                <div class="status" role="status" aria-live="polite" style="padding:6px 18px">@AppState.Status</div>
            }

            @if (!AppState.Busy && AppState.DupeGroups.Count > 0 && !_bannerDismissed)
            {
                <div class="banner">
                    <div style="flex:1">
                        <div class="banner-title">
                            @AppState.DupeGroups.Count.ToString("N0") duplicate groups are waiting — @AppState.FormattedReclaimable of them.
                        </div>
                        <div class="banner-sub">
                            Found automatically when the scan finished. One group at a time, keeper
                            already picked.
                        </div>
                    </div>
                    <button class="btn btn-primary" style="font-size:12.5px" @onclick="() => { _bannerDismissed = true; OpenDupeReview(); }">Start reviewing</button>
                    <button class="btn btn-ghost" style="font-size:12.5px" @onclick="() => _bannerDismissed = true">Later</button>
                </div>
            }

            <ScanIssues />
            <PhotoGrid OnPreview="OpenPreview" />

            @* "No photos" has two causes that need opposite responses: a scan that came back
               empty, and a filter that matches none of the library. *@
            @if (!AppState.Busy && AppState.Images.Count == 0 && AppState.ScannedFolder is { } scanned)
            {
                <div class="empty">
                    <p>
                        No photos in <b>@ImageView.ShortFolder(scanned)</b>.
                        @if (AppState.LastUnsupportedTotal > 0)
                        {
                            <text>
                                <br />
                                SnapZap found @AppState.LastUnsupportedTotal.ToString("N0") file@(AppState.LastUnsupportedTotal == 1 ? "" : "s")
                                it can't read yet — see the note above the grid.
                            </text>
                        }
                        else
                        {
                            <text>
                                <br />
                                Check the folder is the right one, and that it holds images rather
                                than a folder of folders you meant to point at instead.
                            </text>
                        }
                    </p>
                </div>
            }
            else if (!AppState.Busy && AppState.Images.Count > 0 && Shown == 0)
            {
                <div class="empty">
                    <p>
                        None of the @AppState.Images.Count.ToString("N0") photos match these filters.
                        @if (AppState.Nsfw != NsfwFilter.Any && Unchecked > 0)
                        {
                            <text>
                                <br />
                                @Unchecked.ToString("N0") of them have not been checked for explicit
                                content, so this filter hides them.
                            </text>
                        }
                        <br />
                        <button class="btn btn-ghost" @onclick="() => AppState.ClearFilters()">Clear filters</button>
                    </p>
                </div>
            }

            <SelectionBar OnOpenExport="OpenExport" OnOpenHide="OpenHide" />
        </section>
    </main>
}

<Toast />

<ExportDialog Show="_showExport" OnClose="CloseExport" />
<HideDialog Show="_showHide" OnClose="CloseHide" />
<ExtractDialog Show="_showExtract" OnClose="CloseExtract" />
<UndoDialog Show="_showUndo" OnClose="CloseUndo" />
<PreviewModal Img="_previewImg" OnClose="ClosePreview" OnNavigate="img => _previewImg = img" />
<DupeReview Show="_showDupes" OnClose="() => _showDupes = false" />
<DependencyDialog Show="_showDeps" OnClose="() => _showDeps = false" />
<SetupDialog Show="_showSetup" OnClose="() => _showSetup = false" />
<HelpDialog Show="_showHelp" OpenAt="@_helpAt" OnClose="CloseHelp" />

@code {
    bool _showExport;
    bool _showHide;
    bool _showExtract;
    bool _showUndo;
    bool _showDeps;
    bool _showDupes;
    bool _showSetup;
    bool _showHelp;
    bool _scopeMenuOpen;
    bool _bannerDismissed;

    Rail? _rail;

    /// <summary>Which help section to land on. Set by <see cref="OpenHelp"/> so a "what does
    /// this mean?" link can open the paragraph that answers it rather than the front page.</summary>
    string? _helpAt;

    ImageView? _previewImg;

    int Shown => AppState.Filtered().Count;
    int SelectAllCount => AppState.SelectableCount(Scope.AllShown);

    double ScanPercent => AppState.BusyFraction is { } f ? Math.Round(f * 100, 1) : 35;

    /// <summary>
    /// The noun for the big counter's "N of about M ___" line — null for operations that don't
    /// get the rich progress block (Forget and Restore keep their generic mhead label + Stop
    /// button, which is all those one-shot batches need).
    /// </summary>
    string? BusyProgressNoun => AppState.BusyLabel switch
    {
        "Scanning" => "photos read",
        "Finding duplicates" => "photos compared",
        "Scoring NSFW" => "photos scored",
        "Moving to the Recycle Bin" => "photos moved",
        _ => null,
    };

    static string ScopeLabel(Scope scope) => scope switch
    {
        Scope.LikelyExplicit => "Flagged",
        Scope.NotSure => "Not sure",
        Scope.DuplicateKeepers => "Keepers",
        _ => scope.ToString(),
    };

    sealed record FilterChip(string Label, Action Clear);

    /// <summary>One dismissible chip per active filter dimension, so several can combine (a
    /// folder plus a year plus a duplicates facet) without collapsing into one vague count.</summary>
    IEnumerable<FilterChip> ActiveFilterChips()
    {
        if (AppState.DupeFilter != DupeFilter.Any)
            yield return new FilterChip(DupeFilterLabel(AppState.DupeFilter), () => AppState.DupeFilter = DupeFilter.Any);
        if (AppState.Nsfw != NsfwFilter.Any)
            yield return new FilterChip(NsfwFilterLabel(AppState.Nsfw), () => AppState.Nsfw = NsfwFilter.Any);
        if (AppState.BlurMax > 0)
            yield return new FilterChip($"Blurrier than {AppState.BlurMax}", () => AppState.BlurMax = 0);
        if (AppState.Folder.Length > 0)
            yield return new FilterChip(ImageView.ShortFolder(AppState.Folder), () => AppState.Folder = "");
        if (AppState.Year.Length > 0)
            yield return new FilterChip(AppState.Year, () => AppState.Year = "");
        if (!AppState.IncludeSubfolders)
            yield return new FilterChip("This folder only", () => AppState.IncludeSubfolders = true);
    }

    static string DupeFilterLabel(DupeFilter f) => f switch
    {
        DupeFilter.ExtrasOnly => "Extra copies only",
        DupeFilter.KeepersOnly => "Keepers only",
        DupeFilter.BurstOnly => "Burst frames",
        _ => "",
    };

    static string NsfwFilterLabel(NsfwFilter f) => f switch
    {
        NsfwFilter.Likely => "Likely explicit",
        NsfwFilter.Unsure => "Not sure",
        NsfwFilter.Review => "Likely or not sure",
        NsfwFilter.Clean => "Looks clean",
        NsfwFilter.Unchecked => "Not checked yet",
        _ => "",
    };

    /// <summary>
    /// Picking a sort also picks the only direction anyone wants from it. Choosing "Explicit
    /// content" ascending put the tamest photos first — the opposite of why the option was
    /// clicked. The arrow still flips it afterwards.
    /// </summary>
    void SortChanged(ChangeEventArgs e)
    {
        if (!Enum.TryParse<SortKey>(e.Value?.ToString(), out var key)) return;
        AppState.Sort = key;
        AppState.SortDescending = key is SortKey.Nsfw or SortKey.Size or SortKey.Captured;
    }

    /// <summary>Photos nobody has scored yet. Surfaced because an unscored library looks
    /// exactly like a clean one, and only one of those is worth acting on.</summary>
    int Unchecked => AppState.CountInBand(AppState.NsfwBand.Unchecked);

    /// <summary>States where the sort is now and what pressing this does — both audiences get
    /// the same sentence, so the tooltip and the screen reader can't contradict each other.</summary>
    string SortDirLabel => AppState.SortDescending
        ? "Sorted descending — switch to ascending"
        : "Sorted ascending — switch to descending";

    protected override async Task OnInitializedAsync()
    {
        AppState.Changed += StateHasChanged;

        // Bring the Filters tab forward the moment scoring ends, so the flagged/not-sure
        // results are the next thing on screen instead of a second click away.
        AppState.NsfwScoringFinished += OnNsfwScoringFinished;

        // The Setup pip is rendered here, so this page has to hear about a re-check. The
        // checker is a singleton shared across circuits, so the event can arrive off this
        // circuit's synchronization context.
        Checker.Changed += OnDepsChanged;

        // The selection is shared by every window on this library. That event can arrive from
        // another circuit's thread, so it must be marshalled onto this one before rendering.
        Session.Changed += OnSelectionChangedElsewhere;

        // Validate the optional sidecars at launch. Only surfaced when something is actually
        // missing and the user hasn't asked to stop being reminded — a clean install with
        // everything present never sees a dialog.
        if (!Checker.PromptSuppressed && Checker.MissingCount > 0)
            _showDeps = true;

        await AppState.LoadAsync();
    }

    void OpenPreview(ImageView img) => _previewImg = img;
    void ClosePreview() => _previewImg = null;

    void OpenExport() => _showExport = true;
    void CloseExport() => _showExport = false;

    void OpenHide() => _showHide = true;
    void CloseHide() => _showHide = false;

    void OpenExtract() => _showExtract = true;
    void CloseExtract() => _showExtract = false;

    void OpenUndo() => _showUndo = true;
    void CloseUndo() => _showUndo = false;

    void OpenDupeReview() => _showDupes = true;

    void OnNsfwScoringFinished() => _rail?.ShowFiltersTab();

    /// <summary>Flips relative to what's actually painted (asked of the DOM, not assumed from
    /// stored settings) so a first click always matches what the user is looking at, even when
    /// that came from the OS preference rather than an earlier explicit choice.</summary>
    async Task ToggleTheme()
    {
        var current = await JS.InvokeAsync<string>("snapzap.resolvedTheme");
        var next = current == "dark" ? "light" : "dark";
        await JS.InvokeVoidAsync("snapzap.setTheme", next);
        Checker.Theme = next;
    }

    /// <summary>Open help at a named section — see HelpDialog's own Section enum for the names.</summary>
    void OpenHelp(string? section)
    {
        _helpAt = section;
        _showHelp = true;
    }

    void CloseHelp()
    {
        _showHelp = false;
        _helpAt = null;
    }

    void OnSelectionChangedElsewhere() => InvokeAsync(() =>
    {
        AppState.RefreshSelection();
        StateHasChanged();
    });

    void OnDepsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AppState.Changed -= StateHasChanged;
        AppState.NsfwScoringFinished -= OnNsfwScoringFinished;
        Checker.Changed -= OnDepsChanged;
        Session.Changed -= OnSelectionChangedElsewhere;
    }
}
