@implements IDisposable
@inject DependencyChecker Checker

@*
    The full status of the optional sidecars, reachable at any time from the gear in the top
    bar. Distinct from DependencyDialog, which is the once-at-launch prompt and lists only
    what is missing; this one always shows both, so "is czkawka actually being used, and
    which copy?" has an answer even when nothing is wrong.
*@
@if (Show)
{
    <div class="dlg" role="dialog" aria-modal="true" aria-label="Setup"
         tabindex="-1" @ref="_ref" @onkeydown="HandleKeyDown">
        <div class="dlg-box">
            <h2>Setup</h2>
            <p class="dlg-sub">
                Two optional add-ons. SnapZap scans, finds exact duplicates, exports and
                deletes without either of them.
            </p>

            <DependencyList Items="Checker.Current" Detailed="true" />

            <div class="dlg-actions">
                <button class="primary" @onclick="Recheck">@(_checking ? "Checking…" : "Check again")</button>
                <button class="link" @onclick="Close">Close</button>
            </div>
            <p class="hint">Drop a file in and press Check again — no restart needed.</p>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    ElementReference _ref;
    bool _checking;
    bool _wasShown;
    bool _needsFocus;

    protected override void OnInitialized() => Checker.Changed += OnChanged;

    // The checker is a singleton shared across circuits, so a re-check may arrive off this
    // circuit's synchronization context.
    void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Checker.Changed -= OnChanged;

    protected override void OnParametersSet()
    {
        if (Show && !_wasShown) _needsFocus = true;
        _wasShown = Show;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Show && _needsFocus)
        {
            _needsFocus = false;
            await _ref.FocusAsync();
        }
    }

    async Task Recheck()
    {
        _checking = true;
        StateHasChanged();
        // Give the spinner a frame; detection itself is a couple of file probes.
        await Task.Delay(150);
        Checker.Check();
        _checking = false;
    }

    Task Close() => OnClose.InvokeAsync();

    Task HandleKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;
}
