@implements IDisposable
@inject DependencyChecker Checker
@inject CatalogService Catalog
@inject AppState AppState

@using SnapZap.Core.Dedup
@using SnapZap.Core.Nsfw

@*
    The full status of the optional sidecar plus the duplicate-detection settings, reachable at
    any time from the gear in the top bar. Distinct from DependencyDialog, which is the
    once-at-launch prompt and lists only what is missing; this one always shows everything, so
    "is the model actually being used, and which copy?" has an answer even when nothing is wrong.
*@
@if (Show)
{
    <div class="dlg" role="dialog" aria-modal="true" aria-label="Setup"
         tabindex="-1" @ref="_ref" @onkeydown="HandleKeyDown">
        <div class="dlg-box">
            <h2>Setup</h2>
            <p class="dlg-sub">
                One optional add-on. SnapZap scans, finds duplicates, exports and deletes
                without it.
            </p>

            <DependencyList Items="Checker.Current" Detailed="true" />
            <p class="hint">Drop a file in and press Check again — no restart needed.</p>

            @* Each check costs time on a large library and each has a different tolerance for
               being wrong, so which ones run is the user's call rather than a constant. *@
            <section class="setup-block">
                <h3>What "Find duplicates" checks</h3>

                <label class="setup-check">
                    <input type="checkbox" checked disabled />
                    <span>
                        <b>Identical files</b>
                        <span class="quiet">Byte-for-byte copies, by checksum. Always on — free and exact.</span>
                    </span>
                </label>

                <label class="setup-check">
                    <input type="checkbox" checked="@_dedup.VariantEnabled"
                           @onchange="e => Set(_dedup with { VariantEnabled = (bool)e.Value! })" />
                    <span>
                        <b>The same shot at another size</b>
                        <span class="quiet">
                            Resized, re-saved or converted copies of one photo. Safe to bulk-select.
                        </span>
                    </span>
                </label>

                @if (_dedup.VariantEnabled)
                {
                    <div class="setup-nested">
                        <label class="setup-check">
                            <input type="checkbox" checked="@_dedup.VariantRotations"
                                   @onchange="e => Set(_dedup with { VariantRotations = (bool)e.Value! })" />
                            <span>Also match rotated copies <span class="quiet">(slower)</span></span>
                        </label>

                        <label class="setup-range">
                            <span>How different they may look</span>
                            <input type="range" min="4" max="60" step="2" value="@_dedup.VariantMaxBits"
                                   @onchange="e => Set(_dedup with { VariantMaxBits = ToInt(e.Value, _dedup.VariantMaxBits) })" />
                            @* Shown with its scale, because the number is meaningless without one —
                               and it is NOT the old czkawka --max-difference value. *@
                            <b>@_dedup.VariantMaxBits of @PerceptualHash.Bits</b>
                        </label>
                        <p class="hint">
                            Lower is stricter. Raising it finds more, and eventually starts calling
                            two different photos the same one.
                        </p>
                    </div>
                }

                @* No checkbox, deliberately. Burst detection is what keeps different photographs
                   out of a bulk delete, so it runs like exact matching does: always. It used to be
                   off by default, which did not leave bursts ungrouped — it left them grouped as
                   "same shot" and selectable. Only the window is tunable. *@
                <div class="setup-check setup-check--fixed">
                    <span>
                        <b>Bursts — the same scene, seconds apart</b>
                        <span class="quiet">
                            Always detected. These are different photographs, so they are grouped
                            for review and never picked up by "Select duplicate extras".
                        </span>
                    </span>
                </div>

                <div class="setup-nested">
                    <label class="setup-range">
                        <span>Frames within</span>
                        <input type="range" min="1" max="30" step="1" value="@_dedup.BurstWindowSeconds"
                               @onchange="e => Set(_dedup with { BurstWindowSeconds = ToInt(e.Value, _dedup.BurstWindowSeconds) })" />
                        <b>@_dedup.BurstWindowSeconds s</b>
                    </label>
                    <p class="hint">
                        Needs an EXIF capture time — photos without one are skipped, so a burst
                        with no timestamps is not protected from bulk selection.
                    </p>
                </div>

                @if (_settingsChanged)
                {
                    <p class="hint">Saved. Run <b>Find duplicates</b> again to apply it.</p>
                }
            </section>

            @* The one NSFW setting worth exposing. Not a threshold slider: the thresholds are
               calibrated together against measured data, and a slider invites moving one of them
               in isolation, which is how the review queue fills with photographs of faces. *@
            <section class="setup-block">
                <h3>How "Score NSFW" looks</h3>

                <label class="setup-check">
                    <input type="checkbox" checked="@(Checker.NsfwDepth == NsfwDepth.Tiled)"
                           @onchange="e => SetDepth((bool)e.Value! ? NsfwDepth.Tiled : NsfwDepth.WholeFrame)" />
                    <span>
                        <b>Also look closely, in nine overlapping pieces</b>
                        <span class="quiet">
                            The model sees a small thumbnail of whatever it is given, so a person
                            who takes up only part of a wide photo can be missed entirely. Looking
                            piece by piece catches those. Ten times slower.
                        </span>
                    </span>
                </label>

                @if (Checker.NsfwDepth == NsfwDepth.WholeFrame)
                {
                    <p class="hint">
                        With this off, expect to miss photos where the subject isn't most of the
                        frame. On a test folder it found 17 of 41; with it on, 25.
                    </p>
                }
                else
                {
                    <p class="hint">
                        Photos already scored the quick way are re-scored next time you press
                        <b>Score NSFW</b> — the two answers aren't comparable.
                    </p>
                }
            </section>

            @* The catalogue spans every folder ever scanned, because that cache is what makes
               re-scanning fast. Only the scanned folder is ever shown or acted on, but the
               disk it occupies is real and there was previously no way to reclaim it without
               deleting files by hand. *@
            <section class="setup-block">
                <h3>Catalogue</h3>
                <div class="setup-stat">
                    <b>@_footprint.Photos.ToString("N0")</b> photo@(_footprint.Photos == 1 ? "" : "s") analysed
                    <span class="quiet">
                        @AppState.FormatBytes(_footprint.DbBytes) database ·
                        @AppState.FormatBytes(_footprint.ThumbBytes) thumbnails
                    </span>
                </div>
                @if (Catalog.ScanRoot is { } root)
                {
                    <div class="setup-stat quiet">Showing <code class="dep-path">@root</code></div>
                }

                @if (!_confirmForget)
                {
                    <button class="danger" disabled="@(_footprint.Photos == 0 || AppState.Busy)"
                            @onclick="ArmForget">Forget everything…</button>
                }
                else
                {
                    <div class="confirm" role="alertdialog" aria-modal="true" aria-label="Confirm forget"
                         tabindex="-1" @ref="_forgetRef">
                        <p>
                            Discard the analysis of all <b>@_footprint.Photos.ToString("N0")</b> photos
                            and @AppState.FormatBytes(_footprint.ThumbBytes) of thumbnails?
                        </p>
                        <p class="hint">
                            No photo is deleted or moved — only hashes, scores, dates and thumbnails,
                            all of which a scan rebuilds. Anything already in the Recycle Bin stays
                            restorable from History.
                        </p>
                        <div class="row">
                            <button class="danger" @onclick="Forget">Forget everything</button>
                            <button class="link" @onclick="DeclineForget">Cancel</button>
                        </div>
                    </div>
                }
            </section>

            <div class="dlg-actions">
                <button class="primary" @onclick="Recheck">@(_checking ? "Checking…" : "Check again")</button>
                <button class="link" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    ElementReference _ref;
    ElementReference _forgetRef;
    bool _checking;
    bool _wasShown;
    bool _needsFocus;
    bool _confirmForget;
    bool _needsForgetFocus;

    // Measured when the dialog opens rather than per render: it stats every thumbnail, and
    // Blazor re-renders this component on any dependency change.
    (int Photos, long DbBytes, long ThumbBytes) _footprint;

    DedupSettings _dedup = new();
    bool _settingsChanged;

    protected override void OnInitialized() => Checker.Changed += OnChanged;

    /// <summary>
    /// Persist immediately on every toggle rather than behind a Save button.
    /// </summary>
    /// <remarks>
    /// There is nothing to cancel: the settings only take effect on the next detection run, which
    /// the user starts explicitly. A Save button here would just be a way to lose a change by
    /// closing the dialog — and the tree's pending dots update from the stored value, so they
    /// would disagree with the checkboxes until it was pressed.
    /// </remarks>
    void Set(DedupSettings next)
    {
        _dedup = next;
        _dedup.Save(Catalog.Db);
        _settingsChanged = true;

        // The folder tree counts a row as checked only when the run that stamped it covered every
        // enabled detector, so switching one on has to re-render the tree, not just this dialog.
        AppState.NotifyDedupSettingsChanged();
    }

    /// <summary>
    /// Persists immediately, like the dedup toggles above. Raising Changed on the checker is what
    /// re-renders this dialog, since the value it renders from lives on the singleton.
    /// </summary>
    void SetDepth(NsfwDepth depth) => Checker.NsfwDepth = depth;

    /// <summary>
    /// Range inputs post strings, and a malformed one must not throw inside an event handler —
    /// that tears down the circuit and takes the whole page with it.
    /// </summary>
    static int ToInt(object? raw, int fallback) =>
        int.TryParse(raw as string, out var v) ? v : fallback;

    // The checker is a singleton shared across circuits, so a re-check may arrive off this
    // circuit's synchronization context.
    void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Checker.Changed -= OnChanged;

    protected override void OnParametersSet()
    {
        if (Show && !_wasShown)
        {
            _needsFocus = true;
            _confirmForget = false;      // never reopen with a destructive prompt already armed
            _footprint = Catalog.Footprint();

            // Re-read on open rather than caching per circuit: another window may have changed
            // these, and showing a stale checkbox for a setting that governs deletion is not a
            // cosmetic problem.
            _dedup = DedupSettings.Load(Catalog.Db);
            _settingsChanged = false;
        }
        _wasShown = Show;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Show && _needsFocus)
        {
            _needsFocus = false;
            await _ref.FocusAsync();
        }
        else if (_confirmForget && _needsForgetFocus)
        {
            _needsForgetFocus = false;
            await _forgetRef.FocusAsync();
        }
    }

    void ArmForget()
    {
        _confirmForget = true;
        _needsForgetFocus = true;
    }

    // Declining unmounts the element that had focus. Pull it back to the dialog, or focus
    // lands on <body> and the dialog's own Escape handler stops hearing anything.
    void DeclineForget()
    {
        _confirmForget = false;
        _needsFocus = true;
    }

    async Task Forget()
    {
        _confirmForget = false;
        await AppState.ForgetEverythingAsync();
        _footprint = Catalog.Footprint();
        await Close();
    }

    async Task Recheck()
    {
        _checking = true;
        StateHasChanged();
        // Give the spinner a frame; detection itself is a couple of file probes.
        await Task.Delay(150);
        Checker.Check();
        _checking = false;
    }

    Task Close() => OnClose.InvokeAsync();

    /// <summary>
    /// Escape backs out one layer at a time: first the purge confirmation, then the dialog.
    /// Deliberately the only Escape handler here — a second one on the confirmation itself ran
    /// first and cleared the flag this one tests, so declining the purge also shut the dialog
    /// behind it and the user lost their place instead of simply saying no.
    /// </summary>
    Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_confirmForget) { DeclineForget(); return Task.CompletedTask; }
        return Close();
    }
}
