@implements IDisposable
@inject AppState AppState
@inject CatalogService Catalog
@inject ILinkService Links
@inject ITrashService Trash

@if (Show)
{
    <div class="dlg" role="dialog" aria-modal="true" aria-label="Export selected photos"
         tabindex="-1" @ref="_dlgRef" @onkeydown="HandleKeyDown">
        <div class="dlg-box wide">
            <div style="display:flex;align-items:baseline;gap:10px;margin-bottom:4px">
                <h2>Export @AppState.Selected.Count.ToString("N0") photo@(AppState.Selected.Count == 1 ? "" : "s")</h2>
                <span style="font-size:12.5px;color:var(--color-neutral-700)">@AppState.FormattedSelectedBytes</span>
            </div>
            <p class="dlg-sub">Writes the photos you picked into a clean folder. Your source library is untouched unless you choose Move below.</p>
            <hr class="hr" style="margin:0 0 16px" />

            <div style="display:grid;grid-template-columns:1fr 280px;gap:var(--space-6)">
                <div>
                    <div class="field">
                        <label>Destination — absolute path</label>
                        <div style="display:flex;gap:8px">
                            <input class="input" style="flex:1" type="text" placeholder="Where the clean library goes" spellcheck="false"
                                   @bind="_destination" @bind:event="oninput" @bind:after="InvalidatePreflight" />
                            <button class="btn btn-secondary" type="button" @onclick="() => _showPicker = true">Browse…</button>
                        </div>
                        <div class="hint">Relative paths are rejected: one would quietly resolve inside the folder you are cleaning.</div>
                    </div>

                    <div class="field">
                        <label>Transfer mode</label>
                        <div class="seg">
                            @foreach (var m in Enum.GetValues<TransferMode>())
                            {
                                <label class="seg-opt">
                                    <input type="radio" name="mode" checked="@(_mode == m)" @onchange="() => SetMode(m)" />@m
                                </label>
                            }
                        </div>
                        <div class="hint">Copy — originals stay exactly where they are. Move verifies the hash before removing the source; Hardlink needs one drive.</div>
                    </div>

                    <div class="field">
                        <label>Folder structure</label>
                        <div class="seg">
                            @foreach (var s in Enum.GetValues<ExportStructure>())
                            {
                                <label class="seg-opt">
                                    <input type="radio" name="structure" checked="@(_structure == s)" @onchange="() => SetStructure(s)" />@StructureLabel(s)
                                </label>
                            }
                        </div>
                    </div>

                    <div style="padding:11px 12px;background:var(--color-accent-100);border-left:4px solid var(--color-accent)">
                        <label class="radio" style="align-items:flex-start">
                            <input type="checkbox" disabled="@(RejectCount == 0)" @bind="_recycleRejects" @bind:after="InvalidatePreflight" />
                            <span class="dot" style="margin-top:3px"></span>
                            <span style="font-size:12.5px">
                                @if (RejectCount == 0)
                                {
                                    <text>Everything is selected, so there is nothing left to recycle.</text>
                                }
                                else
                                {
                                    <text>
                                        Also recycle the @RejectCount.ToString("N0") photo@(RejectCount == 1 ? "" : "s") I didn't pick
                                        <span style="display:block;color:var(--color-accent-700);font-size:11.5px;margin-top:3px">
                                            Runs only after this export is written and verified. Covers the whole catalogue, not just what your filters show. Reversible from History.
                                        </span>
                                    </text>
                                }
                            </span>
                        </label>
                    </div>

                    @if (_recycleRejects && RejectCount > 0)
                    {
                        <div class="confirm" style="margin-top:12px">
                            <p>
                                <b>@RejectCount.ToString("N0")</b> photo@(RejectCount == 1 ? "" : "s")
                                (@AppState.FormatBytes(RejectBytes)) will go to the Recycle Bin after the
                                export verifies.
                            </p>
                        </div>
                    }
                </div>

                <div>
                    @if (_preflight is { } p)
                    {
                        <div style="display:flex;align-items:center;gap:7px;margin-bottom:10px">
                            <span class="tag @(p.EnoughSpace ? "tag-accent" : "")" style="font-weight:600">CHECKED</span>
                        </div>
                        <div class="preflight">
                            <div class="preflight-row ok">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                                <span>@p.KeeperCount.ToString("N0") photo@(p.KeeperCount == 1 ? "" : "s") · @AppState.FormatBytes(p.TotalBytes) to write</span>
                            </div>
                            @if (p.DestinationFreeBytes is { } freeBytes)
                            {
                                <div class="preflight-row @(p.EnoughSpace ? "ok" : "bad")">
                                    @if (p.EnoughSpace)
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                                    }
                                    <span>@AppState.FormatBytes(freeBytes) free at the destination — @(p.EnoughSpace ? "enough" : "not enough")</span>
                                </div>
                            }
                            else
                            {
                                <div class="preflight-row warn">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
                                    <span>Couldn't read free space — export isn't blocked, but nothing confirmed it will fit.</span>
                                </div>
                            }
                            @if (p.HardlinkPossible)
                            {
                                <div class="preflight-row ok">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                                    <span>Hardlinks available — uses no extra space</span>
                                </div>
                            }
                            else if (_mode == TransferMode.Hardlink)
                            {
                                <div class="preflight-row warn">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
                                    <span>Hardlinks unavailable — source and destination are on different drives</span>
                                </div>
                            }
                            @if (p.SampleDestinations.Count > 0)
                            {
                                <div class="preflight-row ok">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                                    <span>Example: @p.SampleDestinations[0]</span>
                                </div>
                            }
                        </div>
                        <div class="hint" style="margin-bottom:16px">Change the destination, mode or structure and this check clears itself — Export can never be armed for a plan nothing verified.</div>
                    }
                    else
                    {
                        <div class="hint" style="margin-bottom:16px">Check the destination before exporting — free space and hardlink availability are verified here, not guessed.</div>
                    }

                    <button class="btn btn-secondary btn-block" @onclick="RunPreflight">Check @(_preflight is null ? "destination" : "again")</button>
                    <button class="btn btn-primary btn-block" disabled="@(_preflight is null || !_preflight.EnoughSpace || _running || _done)" @onclick="RunExport">
                        @(_running ? "Exporting…" : $"Export {AppState.Selected.Count:N0} photos")
                    </button>

                    <div class="dlg-actions" style="margin-top:10px">
                        @if (_running)
                        {
                            <button class="btn btn-danger" disabled="@(_cts is not { IsCancellationRequested: false })" @onclick="StopExport">
                                @(_cts is { IsCancellationRequested: false } ? "Stop" : "Stopping…")
                            </button>
                        }
                        else if (_done)
                        {
                            <button class="btn btn-ghost" @onclick="Close">Done</button>
                        }
                        else
                        {
                            <button class="btn btn-ghost" @onclick="Close">Cancel</button>
                        }
                    </div>
                    @if (_resultText.Length > 0)
                    {
                        <div class="exp-result">@_resultText</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <DirectoryPickerDialog Show="_showPicker" StartPath="@_destination"
                           OnPicked="OnDestinationPicked" OnClose="() => _showPicker = false" />
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    bool _showPicker;
    string _destination = "";
    TransferMode _mode = TransferMode.Copy;
    ExportStructure _structure = ExportStructure.Date;
    bool _recycleRejects;
    bool _running;
    Preflight? _preflight;
    string _resultText = "";
    bool _wasShown;
    bool _done;
    ElementReference _dlgRef;
    CancellationTokenSource? _cts;

    void SetMode(TransferMode m) { _mode = m; InvalidatePreflight(); }
    void SetStructure(ExportStructure s) { _structure = s; InvalidatePreflight(); }

    static string StructureLabel(ExportStructure s) => s switch
    {
        ExportStructure.Date => "By date",
        ExportStructure.Mirror => "Mirror source",
        ExportStructure.Flat => "Flat",
        _ => s.ToString(),
    };

    int RejectCount => AppState.Images.Count - AppState.Selected.Count;

    long RejectBytes => AppState.Images.Where(i => !AppState.Selected.Contains(i.Id)).Sum(i => i.FileSize);

    protected override void OnInitialized() => AppState.Changed += StateHasChanged;

    public void Dispose()
    {
        AppState.Changed -= StateHasChanged;
        // Closing the dialog mid-run (without pressing Stop) must not leave the background
        // export running unobserved — RunExport's own finally still disposes the
        // CancellationTokenSource once it unwinds.
        _cts?.Cancel();
    }

    Task HandleKeyDown(KeyboardEventArgs e) =>
        e.Key == "Escape" && !_running ? Close() : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Show && _needsFocus)
        {
            _needsFocus = false;
            await _dlgRef.FocusAsync();
        }
    }

    bool _needsFocus;

    protected override void OnParametersSet()
    {
        if (Show && !_wasShown) { _preflight = null; _resultText = ""; _done = false; _needsFocus = true; }
        _wasShown = Show;
    }

    ExportRequest BuildRequest() => new()
    {
        Destination = _destination.Trim(),
        SourceRoot = AppState.ScannedFolder ?? "",
        Mode = _mode,
        Structure = _structure,
        RejectAction = _recycleRejects ? RejectAction.Recycle : RejectAction.Leave,
        KeeperIds = AppState.Selected.ToList(),
        RejectIds = _recycleRejects
            ? AppState.Images.Select(i => i.Id).Except(AppState.Selected).ToList()
            : [],
    };

    void RunPreflight()
    {
        _preflight = null;

        if (string.IsNullOrWhiteSpace(_destination))
        {
            _resultText = "Enter a destination folder first.";
            return;
        }
        if (!Path.IsPathRooted(_destination.Trim()))
        {
            // A relative path silently resolved against the server's working directory, which
            // sits inside the source tree — exporting into the folder being cleaned.
            _resultText = "Enter a full path, starting from the root of the drive.";
            return;
        }
        if (_structure == ExportStructure.Mirror && string.IsNullOrWhiteSpace(AppState.ScannedFolder))
        {
            // Mirror needs a source root to make paths relative to. It is only set by a scan in
            // this session, and the cache means reopening and exporting without scanning is the
            // normal path — which used to throw out of Path.GetFullPath and kill the circuit.
            _resultText = "Mirror keeps your existing folder structure, so scan the source folder first — or choose By date or Flat.";
            return;
        }

        try
        {
            var engine = new ExportEngine(Catalog.Db, Links, Trash);
            _preflight = engine.Plan(BuildRequest());
            _resultText = "";
        }
        catch (Exception ex)
        {
            _resultText = $"Could not check that destination: {ex.Message}";
        }
    }

    /// <summary>
    /// Any change to what would be exported invalidates the check. Without this the panel kept
    /// showing a stale "enough room" for a destination and mode the user had since changed —
    /// so Export stayed armed for a Move into a folder that was never checked.
    /// </summary>
    void InvalidatePreflight()
    {
        if (_done) return;   // a finished run is history, not a stale check
        _preflight = null;
        _resultText = "";
    }

    void OnDestinationPicked(string path)
    {
        _destination = path;
        _showPicker = false;
        InvalidatePreflight();
    }

    async Task RunExport()
    {
        if (_preflight is null || _running) return;
        _running = true;
        _resultText = "Exporting…";
        StateHasChanged();

        var engine = new ExportEngine(Catalog.Db, Links, Trash);
        // Progress<T>.Report posts its callback to the sync context rather than running
        // inline, so for a fast/synchronous export the run can finish (and this method can set
        // the final _resultText) before the last progress post is actually delivered. Guard
        // against that post clobbering the final message once we're done.
        var inFlight = true;
        // Export runs its own dialog-scoped progress/cancellation rather than AppState.RunAsync
        // (it needs the preflight/confirm UI RunAsync doesn't model), so it gets its own
        // EtaEstimator instance rather than sharing AppState's.
        var eta = new EtaEstimator();
        var progress = new Progress<ExportProgress>(p =>
        {
            if (!inFlight) return;
            var remaining = eta.Estimate(Environment.TickCount64, p.Done, p.Total);
            var etaSuffix = remaining is { } r ? $" · ~{EtaEstimator.Format(r)} left" : "";
            _resultText = $"{p.Phase} {p.Done}/{p.Total}{etaSuffix} — {p.Current}";
            InvokeAsync(StateHasChanged);
        });

        _cts = new CancellationTokenSource();
        try
        {
            var result = await engine.RunAsync(BuildRequest(), progress, _cts.Token);
            inFlight = false;
            var (csv, _) = ManifestWriter.Write(Catalog.Db, result, Catalog.ManifestDir);

            var bits = new List<string> { $"Exported {result.Exported}" };
            if (result.SkippedExisting > 0) bits.Add($"{result.SkippedExisting} already there");
            if (result.Failed > 0) bits.Add($"{result.Failed} failed");
            if (result.Recycled > 0) bits.Add($"{result.Recycled} recycled");
            _resultText = string.Join(" · ", bits);

            // Move deletes the originals. Saying only "Exported N" — identical to Copy — hides
            // the destructive half of what just happened.
            if (_mode == TransferMode.Move && result.Exported > 0)
                _resultText += $"\n{result.Exported} original{(result.Exported == 1 ? " was" : "s were")} removed from the source folder. Undo it from History.";

            _resultText += $"\nManifest written to {csv}";
            _done = true;
            AppState.HasExportedThisSession = true;

            await AppState.LoadAsync();
        }
        catch (OperationCanceledException)
        {
            inFlight = false;
            // Every file already written was hash-verified before the stop, and a re-run skips
            // them via the resume table — so stopping is safe and costs nothing but time.
            _resultText = "Export stopped. Photos already copied are verified and complete; "
                        + "running it again resumes where this left off.";
            await AppState.LoadAsync();
        }
        catch (Exception ex)
        {
            inFlight = false;
            _resultText = $"Export stopped: {ex.Message}";
        }
        finally
        {
            _running = false;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
        }
    }

    void StopExport() => _cts?.Cancel();

    Task Close() => OnClose.InvokeAsync();
}
