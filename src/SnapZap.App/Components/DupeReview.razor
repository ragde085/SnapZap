@implements IDisposable
@inject AppState AppState
@inject IJSRuntime JS
@inject IStringLocalizer<DupeReviewResources> L

@*
    Group-at-a-time duplicate review: the core motion of the app, which the flat grid can't
    express. Members sit side by side with the facts that actually decide which copy survives —
    resolution, file size, date, location — and picking one rewrites the keeper flag that the
    export engine reads.
*@

@if (Show && Groups.Count > 0 && _compare)
{
    @* Full-resolution comparison. Thumbnails settle an exact duplicate; they cannot settle a
       near-duplicate, where the difference is detail you have to actually look at. *@
    <div class="cmp" role="dialog" aria-modal="true" aria-label="@L["CompareDialogAriaLabel"]"
         tabindex="-1" @ref="_cmpRef" @onkeydown="HandleCompareKey">

        <div class="cmp-bar">
            <span class="cmp-title">@L["CompareGroupTitle", _index + 1, Groups.Count, Distinguisher]</span>
            <div class="cmp-zoom" role="group" aria-label="@L["ZoomGroupAriaLabel"]">
                @foreach (var z in Zooms)
                {
                    <button class="@(_zoom == z ? "on" : "")" @onclick="() => SetZoom(z)">
                        @(z == 0 ? L["ZoomFit"].Value : $"{z}%")
                    </button>
                }
            </div>
            <button class="btn btn-ghost" @onclick="() => _compare = false">@L["CloseButton"]</button>
        </div>

        <div class="cmp-panes" @ref="_panesRef">
            @foreach (var m in Members)
            {
                var isKeeper = AppState.DupeOf.TryGetValue(m.Id, out var dk) && dk.IsKeeper;
                <div class="cmp-col">
                    <div class="cmp-pane @(_zoom == 0 ? "fit" : "")">
                        @if (_zoom == 0)
                        {
                            <img src="@m.FullUrl" alt="@m.FileName" />
                        }
                        else
                        {
                            <img src="@m.FullUrl" alt="@m.FileName"
                                 style="width:@(m.Width is { } w ? w * _zoom / 100 : 0)px" />
                        }
                    </div>
                    @* The folder is here because it is often the only thing that differs. When two
                       copies are byte-identical the distinguisher becomes "choose by location", and
                       the compare view was showing filename, dimensions and size — everything
                       except the one fact it was asking the user to decide on. *@
                    <div class="cmp-meta">
                        <div class="cmp-names">
                            <b title="@m.Path">@m.FileName</b>
                            <span class="cmp-folder" title="@m.Path">@m.Folder</span>
                        </div>
                        <span>@m.Dimensions · @m.SizeLabel</span>
                        <button class="btn @(isKeeper ? "btn-primary" : "btn-secondary")"
                                disabled="@(isKeeper && KeeperCountInGroup <= 1)"
                                title="@(isKeeper && KeeperCountInGroup <= 1 ? L["KeepAtLeastOneHint"] : null)"
                                @onclick="() => ToggleKeeper(m.Id)">
                            @(isKeeper ? L["KeepingThisButton"] : L["KeepThisButton"])
                        </button>
                        @* Delete straight from the comparison. Judging two copies side by side is
                           exactly the moment the decision is obvious, and making the user close
                           the compare view, find the photo in the grid and select it there loses
                           the comparison that produced the decision.

                           A keeper can never be deleted from here: the group would be left with
                           nothing, and "delete the one I just said to keep" is not a thing anyone
                           means. Mark another copy as the keeper first. *@
                        <button class="btn btn-danger"
                                disabled="@isKeeper"
                                title="@(isKeeper ? L["CannotDeleteKeeperHint"] : L["DeleteThisTitle"])"
                                @onclick="() => DeleteOne(m.Id)">
                            @L["DeleteThisButton"]
                        </button>
                    </div>
                </div>
            }
        </div>
        <p class="cmp-hint">@L["ComparePanesHint"] <kbd>Esc</kbd> @L["EscClosesHint"]</p>
    </div>
}

@if (Show && Groups.Count > 0)
{
    <div class="dlg" role="dialog" aria-modal="true" aria-label="@L["ReviewDialogAriaLabel"]"
         tabindex="-1" @ref="_dlgRef" @onkeydown="HandleKeyDown">
        <div class="dlg-box review">
            <div class="review-head">
                <div>
                    <span class="eyeb">@L["DuplicateReviewEyebrow"]</span>
                    <h2 style="margin-top:4px">@L["ReviewGroupTitle", _index + 1, Groups.Count]</h2>
                    <p class="dlg-sub">
                        @(Members.Count == 1
                            ? L["ReviewSubtitleSingular", Members.Count, Distinguisher]
                            : L["ReviewSubtitlePlural", Members.Count, Distinguisher])
                    </p>
                </div>
                <div class="review-nav">
                    <button class="btn btn-secondary btn-icon" disabled="@(_index == 0)" @onclick="Prev" aria-label="@L["PreviousGroupAriaLabel"]">‹</button>
                    <button class="btn btn-secondary btn-icon" disabled="@(_index >= Groups.Count - 1)" @onclick="Next" aria-label="@L["NextGroupAriaLabel"]">›</button>
                </div>
            </div>

            <div class="review-grid">
                @foreach (var m in Members)
                {
                    var isKeeper = AppState.DupeOf.TryGetValue(m.Id, out var d) && d.IsKeeper;
                    <button class="review-card @(isKeeper ? "keeper" : "")"
                            aria-pressed="@(isKeeper ? "true" : "false")"
                            disabled="@(isKeeper && KeeperCountInGroup <= 1)"
                            title="@(isKeeper && KeeperCountInGroup <= 1 ? L["KeepAtLeastOneHint"] : null)"
                            @onclick="() => ToggleKeeper(m.Id)">
                        <span class="review-shot">
                            <img src="@m.ThumbUrl" alt="@m.FileName" loading="lazy" />
                            @if (isKeeper)
                            {
                                <span class="review-badge">@L["KeepingBadge"]</span>
                            }
                        </span>
                        @* Facts that are identical across the group can't decide anything, so
                           they recede; whatever actually differs is what the eye needs. *@
                        <span class="review-facts">
                            <b title="@m.Path" class="@Cls(NameDiffers)">@m.FileName</b>
                            <span class="@Cls(PixelsDiffer, Best(m, Pixels))">@m.Dimensions</span>
                            <span class="@Cls(SizeDiffers, Best(m, x => x.FileSize))">@m.SizeLabel</span>
                            <span class="@Cls(FolderDiffers)" title="@m.Folder">@ImageView.ShortFolder(m.Folder)</span>
                            <span class="@Cls(DateDiffers)">@m.CapturedLabel</span>
                        </span>
                    </button>
                }
            </div>

            <div class="dlg-actions">
                <button class="btn btn-primary" @onclick="Next" disabled="@(_index >= Groups.Count - 1)">@L["NextGroupButton"]</button>
                <button class="btn btn-secondary" @onclick="() => _compare = true">@L["CompareFullSizeButton"]</button>
                <button class="btn btn-secondary" @onclick="SelectExtrasAndClose">
                    @L["SelectAllExtrasButton", ExtraCount, AppState.FormattedReclaimable]
                </button>
                <button class="btn btn-ghost" @onclick="Close">@L["DoneButton"]</button>
            </div>
            <p class="hint">
                <kbd>←</kbd> <kbd>→</kbd> @L["ReviewHintMoveGroups"] · <kbd>1</kbd>–<kbd>9</kbd> @L["ReviewHintToggleKeeper"]
                · <kbd>Esc</kbd> @L["ReviewHintClose"] @L["ReviewHintSafetyNote"]
            </p>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    int _index;
    bool _wasShown;
    bool _needsFocus;
    ElementReference _dlgRef;

    bool _compare;
    int _zoom;                       // 0 = fit to pane
    bool _panesWired;
    ElementReference _cmpRef;
    ElementReference _panesRef;

    static readonly int[] Zooms = [0, 100, 200, 400];

    void SetZoom(int z) => _zoom = z;

    Task HandleCompareKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _compare = false;
        return Task.CompletedTask;
    }

    IReadOnlyList<DupeGroup> Groups => AppState.DupeGroups;
    DupeGroup Current => Groups[Math.Clamp(_index, 0, Groups.Count - 1)];

    // Members is read many times per render — by both loops and by every Differs/Best helper —
    // so resolve it once per group rather than on each access.
    IReadOnlyList<ImageView> Members
    {
        get
        {
            var group = Current;
            if (!ReferenceEquals(_membersOf, group))
            {
                _membersOf = group;
                _members = AppState.MembersOf(group);
            }
            return _members;
        }
    }

    DupeGroup? _membersOf;
    IReadOnlyList<ImageView> _members = [];

    /// <summary>
    /// What "Select the extra copies" will actually select — read through the same predicate the
    /// selection itself uses, never counted independently.
    /// </summary>
    /// <remarks>
    /// This counted <c>!IsKeeper</c> alone, with no kind filter and no burst-adjacency check, so it
    /// disagreed with <see cref="AppState.DupeExtraCount"/> on the same catalogue at the same
    /// moment: the panel said 11 extras, this button offered to select 17. The selection was never
    /// unsafe — <c>SelectBy</c> filters properly and did select 11 — but a button that overstates
    /// what it is about to sweep up, on the one control that arms a bulk delete, is exactly the
    /// disagreement <c>DupeAssignment</c>'s own remarks warn about: "a badge, a filter and a count
    /// that answer the question three separate ways is precisely how they start disagreeing."
    /// </remarks>
    int ExtraCount => AppState.DupeOf.Count(kv => kv.Value.IsBulkSelectableExtra);

    /// <summary>How many members of the group currently being reviewed are keepers — more than
    /// one is allowed, but toggling the last one off is refused (see ToggleKeeper), so the button
    /// disables itself instead of silently doing nothing.</summary>
    int KeeperCountInGroup => Members.Count(m => AppState.DupeOf.TryGetValue(m.Id, out var d) && d.IsKeeper);

    protected override void OnInitialized() => AppState.Changed += StateHasChanged;
    public void Dispose() => AppState.Changed -= StateHasChanged;

    protected override void OnParametersSet()
    {
        if (Show && !_wasShown) { _index = 0; _needsFocus = true; }
        _wasShown = Show;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_compare && !_panesWired)
        {
            _panesWired = true;
            await _cmpRef.FocusAsync();
            try
            {
                await JS.InvokeVoidAsync("snapzap.syncComparePanes", _panesRef);
            }
            catch (JSException)
            {
                // Synchronised panning is an enhancement. A stale or failed interop.js must not
                // take the circuit down and blank the whole app — the panes still scroll,
                // just independently.
            }
            catch (JSDisconnectedException) { /* circuit gone */ }
        }
        else if (!_compare && _panesWired)
        {
            // Panes are recreated on each open, so their listeners are too.
            _panesWired = false;
            // Compare took focus onto _cmpRef; closing it back to the review grid left focus on
            // nothing (document.body), which silently killed the 1-9 keeper shortcuts and Esc
            // until the user clicked something — @onkeydown only fires on _dlgRef and its children.
            await _dlgRef.FocusAsync();
        }

        if (Show && _needsFocus && Groups.Count > 0)
        {
            _needsFocus = false;
            await _dlgRef.FocusAsync();
        }
    }

    static long Pixels(ImageView i) => (long)(i.Width ?? 0) * (i.Height ?? 0);

    // Which facts actually vary within this group. Exact duplicates are byte-identical, so
    // resolution and size always tie and location is the only thing that decides — the card
    // has to say so rather than presenting every fact with equal weight.
    bool NameDiffers => Members.Select(m => m.FileName).Distinct().Count() > 1;
    bool PixelsDiffer => Members.Select(Pixels).Distinct().Count() > 1;
    bool SizeDiffers => Members.Select(m => m.FileSize).Distinct().Count() > 1;
    bool FolderDiffers => Members.Select(m => m.Folder).Distinct().Count() > 1;
    bool DateDiffers => Members.Select(m => m.CapturedLabel).Distinct().Count() > 1;

    /// <summary>Identical across the group → muted. Differs → normal. Strict winner → green.</summary>
    static string Cls(bool differs, bool best = false) =>
        !differs ? "quiet" : best ? "win" : "";

    /// <summary>What the user should actually compare on, said plainly.</summary>
    string Distinguisher
    {
        get
        {
            if (PixelsDiffer) return L["DistinguisherDifferentResolutions"];
            if (SizeDiffers) return L["DistinguisherDifferentFileSizes"];
            if (FolderDiffers) return L["DistinguisherChooseByLocation"];
            if (NameDiffers) return L["DistinguisherChooseByName"];
            return L["DistinguisherIdenticalCopies"];
        }
    }

    /// <summary>True when this member is the strict best on a measure — highlights the one
    /// fact that distinguishes copies, instead of leaving the user to compare numbers.</summary>
    bool Best(ImageView m, Func<ImageView, long> measure)
    {
        var value = measure(m);
        if (value == 0) return false;
        var top = Members.Max(measure);
        return value == top && Members.Count(x => measure(x) == top) == 1;
    }

    void Prev() { if (_index > 0) _index--; }
    void Next() { if (_index < Groups.Count - 1) _index++; }

    Task ToggleKeeper(long imageId) => AppState.ToggleKeeperAsync(Current.Id, imageId);

    /// <summary>
    /// Recycles one photo from inside the review. Goes through <see cref="AppState.DeleteAsync"/>
    /// like every other delete in the app, so it recycles rather than hard-deletes, writes an
    /// undo-log entry and is restorable from History — a direct action, not an unguarded one.
    /// </summary>
    async Task DeleteOne(long imageId)
    {
        // Guarded here as well as by the disabled attribute: the button's state is computed at
        // render time, and a keeper flag can change under it (ToggleKeeper on another pane, or
        // another circuit) between that render and the click.
        if (AppState.DupeOf.TryGetValue(imageId, out var d) && d.IsKeeper) return;

        await AppState.DeleteAsync([imageId]);

        // The group may now be down to a single surviving copy, at which point it is no longer a
        // duplicate of anything and Members will not include it — so re-evaluate rather than
        // leaving the user on a comparison of one.
        if (Groups.Count == 0 || _index >= Groups.Count) await Close();
    }

    async Task SelectExtrasAndClose()
    {
        AppState.SelectBy(AppState.SelectionScope.DuplicateExtras);
        await Close();
    }

    async Task HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowRight": Next(); break;
            case "ArrowLeft": Prev(); break;
            case "Escape": await Close(); break;
            default:
                if (e.Key.Length == 1 && char.IsDigit(e.Key[0]))
                {
                    var n = e.Key[0] - '1';
                    if (n >= 0 && n < Members.Count) await ToggleKeeper(Members[n].Id);
                }
                break;
        }
    }

    Task Close() => OnClose.InvokeAsync();
}
