@*
    In-app help: how the app works, and the questions people actually arrive with.

    A dialog rather than a route, for the same reason Setup and History are dialogs — help is
    read *against* the library you are looking at ("which of these is the keeper?"), and
    navigating away to a /help page would take the grid, the filters and the selection off
    screen to answer a question about them.

    This replaced the keyboard-shortcuts dialog rather than sitting beside it. Two help buttons
    in one top bar is a guess about which one holds the answer; the shortcut list is now a
    section here, so there is one place to look and the "?" always leads to it.
*@
@inject IStringLocalizer<HelpDialogResources> L
@if (Show)
{
    <div class="dlg" role="dialog" aria-modal="true" aria-label="@L["HelpDialogAriaLabel"]"
         tabindex="-1" @ref="_ref" @onkeydown="HandleKeyDown">
        <div class="dlg-box help">

            <div class="help-head">
                <div>
                    <h2>@L["HelpTitle"]</h2>
                    <p class="dlg-sub">
                        @L["HelpIntro"]
                    </p>
                </div>
                <button class="btn btn-ghost" @onclick="Close">@L["CloseButton"]</button>
            </div>

            @* Plain buttons in a nav, deliberately not role="tablist". Real tabs promise one tab
               stop and arrow-key movement between the panels; implementing that here means
               roving tabindex and JS focus calls, and announcing a pattern the component does
               not implement is worse than announcing none. Nine tab stops is a fair price. *@
            <div class="help-shell">
                <nav class="help-nav" aria-label="@L["HelpNavAriaLabel"]">
                    @foreach (var s in Sections)
                    {
                        <button class="@(_section == s.Id ? "on" : "")"
                                aria-current="@(_section == s.Id ? "true" : null)"
                                @onclick="() => _section = s.Id">@s.Title</button>
                    }
                </nav>

                <div class="help-body">
                    @Body
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Which section to open on. Lets the caller answer a specific question — a
    /// "what does this mean?" link can land on the paragraph that explains it.</summary>
    [Parameter] public string? OpenAt { get; set; }

    enum Section { Start, Scan, Dupes, Nsfw, Select, Export, Delete, Keys, Faq }

    Section _section = Section.Start;

    ElementReference _ref;
    bool _wasShown;
    bool _needsFocus;

    /// <summary>Computed rather than a static array: the titles route through <see cref="L"/>,
    /// which is only available once the component is instantiated and injected.</summary>
    (Section Id, string Title)[] Sections =>
    [
        (Section.Start,  L["SectionStart"]),
        (Section.Scan,   L["SectionScanning"]),
        (Section.Dupes,  L["SectionDuplicates"]),
        (Section.Nsfw,   L["SectionExplicit"]),
        (Section.Select, L["SectionSelecting"]),
        (Section.Export, L["SectionExporting"]),
        (Section.Delete, L["SectionDeleting"]),
        (Section.Keys,   L["SectionKeyboard"]),
        (Section.Faq,    L["SectionFaq"]),
    ];

    // Windows shows Ctrl, macOS shows the command glyph. The rest of the app resolves this the
    // same way; a shortcut list that names the wrong modifier is worse than no list.
    static string ModKey => OperatingSystem.IsMacOS() ? "⌘" : "Ctrl";

    /// <summary>Wraps a localized value carrying inline HTML (e.g. an emphasized word mid
    /// sentence) so Razor renders it as markup instead of HTML-encoding it. The whole sentence
    /// stays one resx entry — splitting it around the tag would split the grammar too, and
    /// Spanish word order does not track English word order.</summary>
    MarkupString M(string key) => new(L[key]);
    MarkupString M(string key, params object[] args) => new(L[key, args]);

    protected override void OnParametersSet()
    {
        if (Show && !_wasShown)
        {
            _needsFocus = true;
            // Reopening returns to the top of the help, not to wherever the last visit ended —
            // a dialog that reopens two-thirds of the way into "Exporting" reads as broken.
            _section = OpenAt is { } at && Enum.TryParse<Section>(at, true, out var s)
                ? s
                : Section.Start;
        }
        _wasShown = Show;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Show && _needsFocus)
        {
            _needsFocus = false;
            await _ref.FocusAsync();
        }
    }

    Task HandleKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;

    Task Close() => OnClose.InvokeAsync();

    // ---- sections -----------------------------------------------------------
    //
    // Held as fragments rather than separate components: each is prose with no state and no
    // behaviour, and nine one-file components would be nine files to open to check one wording.
    //
    // Picked in C# rather than by a @switch in the markup. Inside a Razor code block, `@Frag;`
    // has to guess where the markup transition ends, and the stray `;` renders as text.

    RenderFragment Body => _section switch
    {
        Section.Scan => Scanning,
        Section.Dupes => Duplicates,
        Section.Nsfw => Explicit,
        Section.Select => Selecting,
        Section.Export => Exporting,
        Section.Delete => Deleting,
        Section.Keys => Keyboard,
        Section.Faq => Faq,
        _ => StartHere,
    };

    RenderFragment StartHere => @<div class="help-sec">
        <h3>@L["StartHeading1"]</h3>
        <ol class="help-steps">
            <li>@M("StartStep1")</li>
            <li>@M("StartStep2")</li>
            <li>@M("StartStep3")</li>
            <li>@M("StartStep4")</li>
        </ol>

        <div class="help-note ok">
            <b>@L["StartNoteTitle"]</b>
            <p>@M("StartNoteFolder")</p>
            <p>@M("StartNoteDelete")</p>
        </div>

        <h3>@L["StartWhereHeading"]</h3>
        <dl class="help-dl">
            <dt>@L["StartTopBarTerm"]</dt><dd>@M("StartTopBarDesc")</dd>
            <dt>@L["StartRailTerm"]</dt><dd>@M("StartRailDesc")</dd>
            <dt>@L["StartGridHeaderTerm"]</dt><dd>@M("StartGridHeaderDesc")</dd>
            <dt>@L["StartBottomBarTerm"]</dt><dd>@M("StartBottomBarDesc")</dd>
            <dt>@L["StartGearTerm"]</dt><dd>@M("StartGearDesc")</dd>
        </dl>
    </div>;

    RenderFragment Scanning => @<div class="help-sec">
        <h3>@L["ScanHeading1"]</h3>
        <p>@M("ScanIntroP1")</p>
        <p>@L["ScanIntroP2"]</p>
        <p>@M("ScanStopNote")</p>

        <h3>@L["ScanReadsHeading"]</h3>
        <p class="help-formats">@M("ScanSupportedFormats")</p>

        <h3>@L["ScanUnsupportedHeading"]</h3>
        <p class="help-formats quiet">@M("ScanUnsupportedFormats")</p>
        <p>@L["ScanUnsupportedNote"]</p>

        <h3>@L["ScanFastHeading"]</h3>
        <p>@L["ScanFastP1"]</p>
        <p>@L["ScanFastP2"]</p>
    </div>;

    RenderFragment Duplicates => @<div class="help-sec">
        <h3>@L["DupeKindsHeading"]</h3>
        <table class="help-table">
            <thead><tr><th>@L["DupeTableKindHeader"]</th><th>@L["DupeTableMeaningHeader"]</th><th>@L["DupeTableBulkHeader"]</th></tr></thead>
            <tbody>
                <tr><td><b>@L["DupeIdenticalTerm"]</b></td><td>@L["DupeIdenticalDesc"]</td><td class="ok">@L["YesLabel"]</td></tr>
                <tr><td><b>@L["DupeSameShotTerm"]</b></td><td>@L["DupeSameShotDesc"]</td><td class="ok">@L["YesLabel"]</td></tr>
                <tr><td><b>@L["DupeBurstTerm"]</b></td><td>@L["DupeBurstDesc"]</td><td class="warn">@L["NoLabel"]</td></tr>
            </tbody>
        </table>

        <div class="help-note warn">
            <b>@L["DupeBurstNoteTitle"]</b>
            <p>@M("DupeBurstNoteBody")</p>
        </div>

        <h3>@L["DupeOnPhotosHeading"]</h3>
        <p>@M("DupeBadgesNote")</p>

        <h3>@L["DupeReviewingHeading"]</h3>
        <p>@M("DupeReviewP1")</p>
        <p>@M("DupeReviewP2")</p>

        <h3>@L["DupeTuningHeading"]</h3>
        <p>@M("DupeTuningIntro")</p>
        <ul>
            <li>@M("DupeTuningIdentical")</li>
            <li>@M("DupeTuningSameShot")</li>
            <li>@M("DupeTuningBursts")</li>
        </ul>
        <p class="hint">@M("DupeTuningHint")</p>
    </div>;

    RenderFragment Explicit => @<div class="help-sec">
        <h3>@L["NsfwHeading"]</h3>
        <p>@M("NsfwP1")</p>
        <p>@L["NsfwP2"]</p>

        <table class="help-table">
            <thead><tr><th>@L["NsfwTableBandHeader"]</th><th>@L["NsfwTableScoreHeader"]</th><th>@L["NsfwTableMeaningHeader"]</th></tr></thead>
            <tbody>
                <tr><td class="warn"><b>@L["NsfwLikelyTerm"]</b></td><td>@L["NsfwLikelyScore"]</td><td>@L["NsfwLikelyMeaning"]</td></tr>
                <tr><td class="warn"><b>@L["NsfwNotSureTerm"]</b></td><td>@L["NsfwNotSureScore"]</td><td>@L["NsfwNotSureMeaning"]</td></tr>
                <tr><td class="ok"><b>@L["NsfwCleanTerm"]</b></td><td>@L["NsfwCleanScore"]</td><td></td></tr>
                <tr><td class="quiet"><b>@L["NsfwNotCheckedTerm"]</b></td><td>—</td><td>@L["NsfwNotCheckedMeaning"]</td></tr>
            </tbody>
        </table>

        <div class="help-note">
            <b>@L["NsfwGuessTitle"]</b>
            <p>@L["NsfwGuessBody"]</p>
        </div>

        <p>@L["NsfwShieldNote"]</p>
    </div>;

    RenderFragment Selecting => @<div class="help-sec">
        <h3>@L["SelectHeading1"]</h3>
        <p>@M("SelectIntro")</p>

        <h3>@L["SelectByHandHeading"]</h3>
        <dl class="help-dl">
            <dt>@L["SelectClickTerm"]</dt><dd>@L["SelectClickDesc"]</dd>
            <dt>@L["SelectShiftClickTerm"]</dt><dd>@L["SelectShiftClickDesc"]</dd>
            <dt>@L["SelectDoubleClickTerm"]</dt><dd>@L["SelectDoubleClickDesc"]</dd>
        </dl>

        <h3>@L["SelectByCommandHeading"]</h3>
        <p>@M("SelectByCommandP1", ModKey)</p>
        <table class="help-table">
            <tbody>
                <tr><td><b>@L["SelectScopeAllTerm"]</b></td><td>@M("SelectScopeAllDesc", ModKey)</td></tr>
                <tr><td><b>@L["SelectScopeFlaggedTerm"]</b></td><td>@L["SelectScopeFlaggedDesc"]</td></tr>
                <tr><td><b>@L["SelectScopeNotSureTerm"]</b></td><td>@L["SelectScopeNotSureDesc"]</td></tr>
                <tr><td><b>@L["SelectScopeKeepersTerm"]</b></td><td>@L["SelectScopeKeepersDesc"]</td></tr>
            </tbody>
        </table>
        <p>@M("SelectExtraCopiesNote")</p>
        <p>@M("SelectInvertClearNote", ModKey)</p>
        <p class="hint">@L["SelectGreyedHint"]</p>

        <div class="help-note warn">
            <b>@L["SelectSharedTitle"]</b>
            <p>@M("SelectSharedBody")</p>
        </div>
    </div>;

    RenderFragment Exporting => @<div class="help-sec">
        <h3>@L["ExportHeading"]</h3>
        <p>@M("ExportIntro")</p>

        <h3>@L["ExportModeHeading"]</h3>
        <dl class="help-dl">
            <dt>@L["ExportCopyTerm"]</dt><dd>@L["ExportCopyDesc"]</dd>
            <dt>@L["ExportMoveTerm"]</dt><dd>@M("ExportMoveDesc")</dd>
            <dt>@L["ExportHardlinkTerm"]</dt><dd>@L["ExportHardlinkDesc"]</dd>
        </dl>

        <h3>@L["ExportStructureHeading"]</h3>
        <dl class="help-dl">
            <dt>@L["ExportByDateTerm"]</dt><dd>@M("ExportByDateDesc")</dd>
            <dt>@L["ExportMirrorTerm"]</dt><dd>@L["ExportMirrorDesc"]</dd>
            <dt>@L["ExportFlatTerm"]</dt><dd>@L["ExportFlatDesc"]</dd>
        </dl>

        <h3>@L["ExportCheckHeading"]</h3>
        <p>@L["ExportCheckP1"]</p>
        <p>@M("ExportCheckP2")</p>

        <h3>@L["ExportRecycleHeading"]</h3>
        <div class="help-note warn">
            <p>@M("ExportRecycleP1")</p>
            <p>@M("ExportRecycleP2")</p>
        </div>

        <h3>@L["ExportWhileHeading"]</h3>
        <p>@M("ExportWhileP1")</p>
        <p>@M("ExportWhileP2")</p>
    </div>;

    RenderFragment Deleting => @<div class="help-sec">
        <h3>@L["DeleteHeading"]</h3>
        <p>@M("DeleteIntroP1")</p>
        <p>@M("DeleteIntroP2")</p>

        <h3>@L["DeleteHistoryHeading"]</h3>
        <p>@M("DeleteHistoryP")</p>
        <table class="help-table">
            <thead><tr><th>@L["DeleteTableEntryHeader"]</th><th>@L["DeleteTableWhatHeader"]</th></tr></thead>
            <tbody>
                <tr><td><b>@L["DeleteEntryDeletedTerm"]</b></td><td>@L["DeleteEntryDeletedDesc"]</td></tr>
                <tr><td><b>@L["DeleteEntryRecycledTerm"]</b></td><td>@L["DeleteEntryRecycledDesc"]</td></tr>
                <tr><td><b>@L["DeleteEntryMovedTerm"]</b></td><td>@M("DeleteEntryMovedDesc")</td></tr>
            </tbody>
        </table>
        <p class="hint">@L["DeleteRestoreHint"]</p>
    </div>;

    RenderFragment Keyboard => @<div class="help-sec">
        <h3>@L["KeysGridHeading"]</h3>
        <div class="shortcuts">
            <div><span>@L["KeysGridMoveLabel"]</span> <kbd>↑</kbd> <kbd>↓</kbd> <kbd>←</kbd> <kbd>→</kbd></div>
            <div><span>@L["KeysGridSelectLabel"]</span> <kbd>X</kbd> <kbd>Space</kbd></div>
            <div><span>@L["KeysGridExtendLabel"]</span> <kbd>Shift</kbd> <kbd>X</kbd></div>
            <div><span>@L["KeysGridOpenPreviewLabel"]</span> <kbd>Enter</kbd></div>
            <div><span>@L["KeysGridFirstLastLabel"]</span> <kbd>Home</kbd> <kbd>End</kbd></div>
            <div><span>@L["KeysGridSelectAllLabel"]</span> <kbd>@ModKey</kbd> <kbd>A</kbd></div>
            <div><span>@L["KeysGridClearLabel"]</span> <kbd>@ModKey</kbd> <kbd>D</kbd></div>
        </div>

        <h3>@L["KeysPreviewHeading"]</h3>
        <div class="shortcuts">
            <div><span>@L["KeysPreviewPrevNextLabel"]</span> <kbd>←</kbd> <kbd>→</kbd></div>
            <div><span>@L["KeysPreviewSelectLabel"]</span> <kbd>X</kbd></div>
            <div><span>@L["KeysPreviewDetailsLabel"]</span> <kbd>I</kbd></div>
            <div><span>@L["KeysPreviewZoomLabel"]</span> <kbd>+</kbd> <kbd>-</kbd></div>
            <div><span>@L["KeysPreviewZoomFitLabel"]</span> <kbd>0</kbd></div>
            <div><span>@L["CloseLabel"]</span> <kbd>Esc</kbd></div>
        </div>

        <h3>@L["KeysReviewHeading"]</h3>
        <div class="shortcuts">
            <div><span>@L["KeysReviewPrevNextLabel"]</span> <kbd>←</kbd> <kbd>→</kbd></div>
            <div><span>@L["KeysReviewPickLabel"]</span> <kbd>1</kbd>–<kbd>9</kbd></div>
            <div><span>@L["CloseLabel"]</span> <kbd>Esc</kbd></div>
        </div>

        <h3>@L["KeysFolderHeading"]</h3>
        <div class="shortcuts">
            <div><span>@L["KeysFolderMoveLabel"]</span> <kbd>↑</kbd> <kbd>↓</kbd></div>
            <div><span>@L["KeysFolderExpandLabel"]</span> <kbd>→</kbd> <kbd>←</kbd></div>
            <div><span>@L["KeysFolderFirstLastLabel"]</span> <kbd>Home</kbd> <kbd>End</kbd></div>
        </div>

        <h3>@L["KeysEverywhereHeading"]</h3>
        <div class="shortcuts">
            <div><span>@L["KeysEverywhereScanLabel"]</span> <kbd>Enter</kbd></div>
            <div><span>@L["KeysEverywhereCloseLabel"]</span> <kbd>Esc</kbd></div>
        </div>

        <p class="hint">@M("KeysTabHint")</p>
        <p class="hint">
            @M("KeysIgnoredHint", ModKey)
        </p>
    </div>;

    RenderFragment Faq => @<div class="help-sec faq">
        <h3>@L["FaqHeading"]</h3>

        <details>
            <summary>@L["FaqQ1"]</summary>
            <p>@L["FaqA1"]</p>
        </details>

        <details>
            <summary>@L["FaqQ2"]</summary>
            <p>@M("FaqA2")</p>
        </details>

        <details>
            <summary>@L["FaqQ3"]</summary>
            <p>@L["FaqA3"]</p>
        </details>

        <details>
            <summary>@L["FaqQ4"]</summary>
            <p>@M("FaqA4")</p>
        </details>

        <details>
            <summary>@L["FaqQ5"]</summary>
            <p>@M("FaqA5")</p>
        </details>

        <details>
            <summary>@L["FaqQ6"]</summary>
            <p>@M("FaqA6")</p>
        </details>

        <details>
            <summary>@L["FaqQ7"]</summary>
            <p>@L["FaqA7"]</p>
        </details>

        <details>
            <summary>@L["FaqQ8"]</summary>
            <p>@M("FaqA8")</p>
        </details>

        <details>
            <summary>@L["FaqQ9"]</summary>
            <p>@M("FaqA9")</p>
        </details>

        <details>
            <summary>@L["FaqQ10"]</summary>
            <p>@L["FaqA10"]</p>
        </details>

        <details>
            <summary>@L["FaqQ11"]</summary>
            <p>@M("FaqA11")</p>
        </details>

        <details>
            <summary>@L["FaqQ12"]</summary>
            <p>@M("FaqA12")</p>
        </details>

        <details>
            <summary>@L["FaqQ13"]</summary>
            <p>@M("FaqA13")</p>
        </details>

        <details>
            <summary>@L["FaqQ14"]</summary>
            <p>@M("FaqA14")</p>
        </details>
    </div>;
}
