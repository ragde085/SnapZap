@implements IDisposable
@inject AppState AppState
@inject IStringLocalizer<ScanIssuesResources> L
@using SnapZap.Core.Scanning

@if (AppState.LastFailures.Count > 0 || AppState.LastUnsupportedTotal > 0)
{
    <div class="issues">
        <button class="issues-head" aria-expanded="@(_open ? "true" : "false")" @onclick="() => _open = !_open">
            <span class="issues-dot" aria-hidden="true"></span>
            <span>@Headline</span>
            <span class="issues-twist @(_open ? "open" : "")" aria-hidden="true">›</span>
        </button>

        @if (_open)
        {
            <div class="issues-body">
                @if (AppState.LastUnsupportedTotal > 0)
                {
                    <div class="issues-group">
                        <div class="issues-reason unsupported">
                            @L["UnsupportedFormatsHeading"] <span>· @AppState.LastUnsupportedTotal.ToString("N0")</span>
                        </div>
                        @foreach (var (format, count) in AppState.LastUnsupported.OrderByDescending(k => k.Value))
                        {
                            <div class="issues-file">@format — @(count == 1 ? L["FileCountSingular", count.ToString("N0")] : L["FileCountPlural", count.ToString("N0")])</div>
                        }
                        <div class="issues-file quiet">
                            @L["UnsupportedFilesUntouchedNote"]
                        </div>
                    </div>
                }

                @foreach (var group in Grouped)
                {
                    <div class="issues-group">
                        <div class="issues-reason">@group.Key <span>· @group.Count()</span></div>
                        @foreach (var f in group.Take(8))
                        {
                            <div class="issues-file" title="@f.Path">@System.IO.Path.GetFileName(f.Path)</div>
                        }
                        @if (group.Count() > 8)
                        {
                            <div class="issues-file quiet">@L["AndMoreCount", group.Count() - 8]</div>
                        }
                    </div>
                }
                <button class="btn btn-ghost" @onclick="() => AppState.ClearFailures()">@L["DismissButton"]</button>
            </div>
        }
    </div>
}

@code {
    bool _open;

    protected override void OnInitialized() => AppState.Changed += StateHasChanged;
    public void Dispose() => AppState.Changed -= StateHasChanged;

    /// <summary>Unreadable formats and genuine errors are different problems; say whichever
    /// applies rather than lumping them under one count.</summary>
    string Headline
    {
        get
        {
            var skipped = AppState.LastFailures.Count;
            var unsupported = AppState.LastUnsupportedTotal;

            if (skipped > 0 && unsupported > 0)
                return L["HeadlineBothCounts", unsupported.ToString("N0"), skipped];
            if (unsupported > 0)
                return unsupported == 1
                    ? L["HeadlineUnsupportedSingular", unsupported.ToString("N0")]
                    : L["HeadlineUnsupportedPlural", unsupported.ToString("N0")];
            return skipped == 1
                ? L["HeadlineSkippedSingular", skipped]
                : L["HeadlineSkippedPlural", skipped];
        }
    }

    // Reason first: one bad codec across 300 files is one problem, not 300.
    IEnumerable<IGrouping<string, ScanFailure>> Grouped =>
        AppState.LastFailures.GroupBy(f => f.Reason).OrderByDescending(g => g.Count());
}
