@implements IDisposable
@inject AppState AppState
@inject IStringLocalizer<ExtractDialogResources> L
@using System.Security.Cryptography

@if (Show)
{
    <div class="dlg" role="dialog" aria-modal="true" aria-label="@L["DialogAriaLabel"]"
         tabindex="-1" @ref="_dlgRef" @onkeydown="HandleKeyDown">
        <div class="dlg-box">
            <h2>@L["Title"]</h2>
            <p class="dlg-sub">
                @L["Subtitle"]
            </p>

            <label class="field">@L["SourceImageLabel"]
                <input type="text" placeholder="@L["SourceImagePlaceholder"]" spellcheck="false"
                       @bind="_sourcePath" @bind:event="oninput" @bind:after="() => _sourceError = ValidateSource()" />
            </label>

            <div class="field">
                <label for="extractOutputFolder">@L["OutputFolderLabel"]</label>
                <div style="display:flex;gap:8px">
                    <input id="extractOutputFolder" type="text" style="flex:1" placeholder="@L["OutputFolderPlaceholder"]" spellcheck="false"
                           @bind="_outputFolder" @bind:event="oninput" />
                    <button class="btn btn-secondary" type="button" @onclick="() => _showPicker = true">@L["BrowseButton"]</button>
                </div>
            </div>

            <label class="field">@L["PassphraseLabel"]
                <input type="password" @bind="_passphrase" @bind:event="oninput" />
            </label>

            @if (_sourceError.Length > 0)
            {
                <div class="preflight"><div class="bad">@_sourceError</div></div>
            }

            <div class="dlg-actions">
                <button class="btn btn-primary" disabled="@(!CanConfirm)" @onclick="RunExtract">
                    @(_running ? L["ExtractingButton"] : L["ExtractButton"])
                </button>
                @if (_running)
                {
                    <button class="btn btn-danger" disabled="@(_cts is not { IsCancellationRequested: false })" @onclick="StopExtract">
                        @(_cts is { IsCancellationRequested: false } ? L["StopButton"] : L["StoppingButton"])
                    </button>
                }
                else if (_done)
                {
                    <button class="btn btn-ghost" @onclick="Close">@L["DoneButton"]</button>
                }
                else
                {
                    <button class="btn btn-ghost" @onclick="Close">@L["CancelButton"]</button>
                }
            </div>
            @if (_resultText.Length > 0)
            {
                <div class="exp-result">@_resultText</div>
            }
        </div>
    </div>

    <DirectoryPickerDialog Show="_showPicker" StartPath="@_outputFolder"
                           OnPicked="OnOutputFolderPicked" OnClose="() => _showPicker = false" />
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    bool _showPicker;
    string _sourcePath = "";
    string _outputFolder = "";
    string _passphrase = "";
    string _sourceError = "";

    bool _running;
    bool _done;
    string _resultText = "";
    bool _wasShown;
    bool _needsFocus;
    ElementReference _dlgRef;
    CancellationTokenSource? _cts;

    protected override void OnInitialized() => AppState.Changed += StateHasChanged;

    public void Dispose()
    {
        AppState.Changed -= StateHasChanged;
        // Closing the dialog mid-run (without pressing Stop) must not leave the background
        // read/decrypt/unzip running unobserved — RunExtract's own finally still disposes the
        // CancellationTokenSource once it unwinds.
        _cts?.Cancel();
    }

    bool CanConfirm =>
        !_running && !_done &&
        _sourceError.Length == 0 &&
        Path.IsPathRooted(_sourcePath.Trim()) && _sourcePath.Trim().Length > 0 &&
        Path.IsPathRooted(_outputFolder.Trim()) && _outputFolder.Trim().Length > 0;

    Task HandleKeyDown(KeyboardEventArgs e) =>
        e.Key == "Escape" && !_running ? Close() : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Show && _needsFocus)
        {
            _needsFocus = false;
            await _dlgRef.FocusAsync();
        }
    }

    protected override void OnParametersSet()
    {
        if (Show && !_wasShown)
        {
            _sourcePath = ""; _outputFolder = ""; _passphrase = "";
            _sourceError = ""; _resultText = ""; _done = false; _needsFocus = true;
        }
        _wasShown = Show;
    }

    string ValidateSource()
    {
        var path = _sourcePath.Trim();
        if (path.Length == 0) return "";
        if (!Path.IsPathRooted(path)) return L["ValidateSourcePathError"];
        if (!File.Exists(path)) return L["ValidateSourceNotFoundError"];
        return "";
    }

    void OnOutputFolderPicked(string path)
    {
        _outputFolder = path;
        _showPicker = false;
    }

    async Task RunExtract()
    {
        if (!CanConfirm || _running) return;
        _running = true;
        _resultText = L["ReadingStatus"];
        StateHasChanged();

        var inFlight = true;
        // ExtractAsync only ever reports ExtractPhase.Reading — Decrypting/Unzipping below are
        // narrated directly by this method, not through the progress channel, since
        // PayloadCrypto.Decrypt/PayloadZipper.ExtractZip don't report progress themselves.
        var progress = new Progress<ExtractProgress>(p =>
        {
            if (!inFlight) return;
            _resultText = L["ReadingStatus"];
            InvokeAsync(StateHasChanged);
        });

        var outputFolder = _outputFolder.Trim();
        // ExtractZip never rolls back a cancelled run — files already written stay on disk.
        // Snapshot what was there before this run so a cancel can still report how many of *this*
        // run's files made it, without inflating the count with unrelated pre-existing ones.
        var before = Directory.Exists(outputFolder)
            ? new HashSet<string>(Directory.GetFiles(outputFolder))
            : [];

        _cts = new CancellationTokenSource();
        var ct = _cts.Token;
        try
        {
            var (payload, encrypted) = await StegoEngine.ExtractAsync(_sourcePath.Trim(), progress, ct);

            byte[] zipBytes;
            if (encrypted)
            {
                if (_passphrase.Length == 0)
                    throw new StegoException(L["PassphraseRequiredError"]);

                _resultText = L["DecryptingStatus"];
                StateHasChanged();
                zipBytes = await Task.Run(() => PayloadCrypto.Decrypt(payload, _passphrase, ct), ct);
            }
            else
            {
                zipBytes = payload;
            }

            _resultText = L["UnzippingStatus"];
            StateHasChanged();
            var written = await Task.Run(() => PayloadZipper.ExtractZip(zipBytes, outputFolder, ct), ct);
            inFlight = false;

            var header = written.Count == 1
                ? L["RecoveredFileSingular", outputFolder]
                : L["RecoveredFilesPlural", written.Count, outputFolder];
            _resultText = $"{header}\n" + string.Join("\n", written.Select(Path.GetFileName));
            _done = true;
        }
        catch (OperationCanceledException)
        {
            inFlight = false;
            var after = Directory.Exists(outputFolder) ? Directory.GetFiles(outputFolder) : [];
            var recovered = after.Count(f => !before.Contains(f));
            _resultText = recovered switch
            {
                0 => L["StoppedNoneRecovered"],
                1 => L["StoppedRecoveredSingular", outputFolder],
                _ => L["StoppedRecoveredPlural", recovered, outputFolder]
            };
        }
        catch (StegoException ex)
        {
            inFlight = false;
            _resultText = ex.Message;
        }
        catch (CryptographicException)
        {
            inFlight = false;
            _resultText = L["IncorrectPassphraseError"];
        }
        catch (Exception ex)
        {
            // Anything else (disk full while writing a recovered file, permissions on the output
            // folder) — show it inline rather than letting an unhandled exception crash the
            // circuit, matching ExportDialog's fallback.
            inFlight = false;
            _resultText = L["ExtractStoppedError", ex.Message];
        }
        finally
        {
            _running = false;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
        }
    }

    void StopExtract() => _cts?.Cancel();

    Task Close() => OnClose.InvokeAsync();
}
