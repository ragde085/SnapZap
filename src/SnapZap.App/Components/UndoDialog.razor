@implements IDisposable
@inject AppState AppState
@inject IStringLocalizer<UndoDialogResources> L

@if (Show)
{
    <div class="dlg" role="dialog" aria-modal="true" aria-label="@L["DialogAriaLabel"]"
         tabindex="-1" @ref="_dlgRef" @onkeydown="HandleKeyDown">
        <div class="dlg-box wide">
            <h3>@L["Title"]</h3>
            @* Not everything here was recycled — an export in Move mode relocates files rather
               than binning them, and calling that "recycled" sends people to the wrong place
               to look for their photos. *@
            <p class="history-note">@L["HistoryNote"]</p>

            @if (_batches.Count == 0)
            {
                <p class="hint">@L["EmptyState"]</p>
            }
            else
            {
                <table class="table">
                    <thead><tr><th>@L["ColumnWhen"]</th><th>@L["ColumnWhatHappened"]</th><th style="text-align:right">@L["ColumnPhotos"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var b in _batches)
                        {
                            var done = b.Restored >= b.Total;
                            var busy = _restoring == b.BatchId;
                            <tr>
                                <td>@L["BatchTimestamp", DateTimeOffset.FromUnixTimeSeconds(b.Ts).LocalDateTime]</td>
                                <td>
                                    @What(b)
                                    <div class="history-sub">
                                        @(WasMoved(b) ? L["SubRelocated"] : done ? L["SubEmptied"] : L["SubInBin"])
                                        @if (b.Restored > 0)
                                        {
                                            <text> @L["SubRestoredCount", b.Restored]</text>
                                        }
                                    </div>
                                    @if (_previews.TryGetValue(b.BatchId, out var items) && items.Count > 0)
                                    {
                                        <div class="undo-thumbs">
                                            @foreach (var it in items)
                                            {
                                                @if (it.ContentHash is not null)
                                                {
                                                    var itemName = Path.GetFileName(it.OriginalPath);
                                                    <div class="undo-thumb-wrap">
                                                        <img class="undo-thumb @(it.Restored ? "restored" : "")" loading="lazy"
                                                             src="@($"/api/thumb/{it.ContentHash}")"
                                                             alt="" title="@itemName" />
                                                        @if (!it.Restored)
                                                        {
                                                            <button type="button" class="undo-thumb-restore @(_restoringItem == it.Id ? "restoring" : "")"
                                                                    disabled="@(busy || _restoringItem is not null)"
                                                                    title="@L["ButtonRestoreThisPhoto", itemName]"
                                                                    aria-label="@L["ButtonRestoreThisPhoto", itemName]"
                                                                    @onclick="() => RestoreItem(it.Id)">
                                                                @if (_restoringItem == it.Id)
                                                                {
                                                                    <span aria-hidden="true">…</span>
                                                                }
                                                                else
                                                                {
                                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5" /></svg>
                                                                }
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            }
                                            @if (b.Total > items.Count)
                                            {
                                                <span class="undo-thumb-more">@L["ThumbMoreCount", b.Total - items.Count]</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td style="text-align:right;font-variant-numeric:tabular-nums">@b.Total.ToString("N0")</td>
                                <td style="text-align:right">
                                    <button class="btn btn-secondary" style="font-size:12px;padding:4px 10px"
                                            disabled="@(done || busy || _restoringItem is not null)" @onclick="() => Restore(b.BatchId)">
                                        @(done ? L["ButtonRestored"] : busy ? L["ButtonRestoring"] : L["ButtonRestore"])
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="history-hint">@L["RightClickHint"]</div>
            <div class="dlg-actions" style="margin-top:14px"><button class="btn btn-ghost" @onclick="Close">@L["CloseButton"]</button></div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    List<UndoBatch> _batches = [];
    Dictionary<string, IReadOnlyList<UndoItem>> _previews = [];
    string? _restoring;
    long? _restoringItem;
    bool _wasShown;
    bool _needsFocus;
    ElementReference _dlgRef;

    protected override void OnInitialized() => AppState.Changed += StateHasChanged;
    public void Dispose() => AppState.Changed -= StateHasChanged;

    protected override void OnParametersSet()
    {
        if (Show && !_wasShown) { Refresh(); _needsFocus = true; }
        _wasShown = Show;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Show && _needsFocus)
        {
            _needsFocus = false;
            await _dlgRef.FocusAsync();
        }
    }

    void Refresh()
    {
        _batches = AppState.Batches().ToList();
        _previews = _batches.ToDictionary(b => b.BatchId, b => AppState.ItemsInBatch(b.BatchId));
    }

    static bool WasMoved(UndoBatch b) => b.BatchId.StartsWith("move-");

    string What(UndoBatch b) => b.BatchId switch
    {
        var s when s.StartsWith("move-") => L["WhatMoved"],
        var s when s.StartsWith("export-") => L["WhatExportRecycled"],
        _ => L["WhatSelectionDeleted"],
    };

    async Task Restore(string batchId)
    {
        _restoring = batchId;
        StateHasChanged();
        try
        {
            await AppState.RestoreAndReloadAsync(batchId);
            Refresh();
        }
        finally
        {
            _restoring = null;
        }
    }

    async Task RestoreItem(long undoLogId)
    {
        _restoringItem = undoLogId;
        StateHasChanged();
        try
        {
            await AppState.RestoreItemAndReloadAsync(undoLogId);
            Refresh();
        }
        finally
        {
            _restoringItem = null;
        }
    }

    Task HandleKeyDown(KeyboardEventArgs e) =>
        e.Key == "Escape" && _restoring is null ? Close() : Task.CompletedTask;

    Task Close() => OnClose.InvokeAsync();
}
