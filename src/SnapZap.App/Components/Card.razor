@implements IDisposable
@inject AppState AppState

<div class="card @(Selected ? "selected" : "")"
     tabindex="@(IsTabStop ? 0 : -1)"
     role="checkbox"
     aria-checked="@(Selected ? "true" : "false")"
     aria-label="@AriaLabel"
     data-card-index="@Index"
     @onclick="HandleClick"
     @ondblclick="HandleDoubleClick"
     @onkeydown="HandleKeyDown">

    <img src="@Img.ThumbUrl" alt="" loading="lazy" />

    <span class="fold" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10" /></svg>
    </span>

    @if (HasBadges)
    {
        <div class="badges" aria-hidden="true">
            @if (NsfwBand is AppState.NsfwBand.Likely or AppState.NsfwBand.Unsure)
            {
                @* Shield-with-warning, not an eye-with-slash: nothing has been hidden, the
                   model has flagged it for a look. *@
                <span class="badge nsfw @(NsfwBand == AppState.NsfwBand.Unsure ? "low" : "")"
                      title="@NsfwBadgeTitle">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 3l8 4v5c0 4.5-3.2 7.9-8 9-4.8-1.1-8-4.5-8-9V7z" />
                        <path d="M12 8v4" />
                        <path d="M12 16h.01" />
                    </svg>
                </span>
            }
            @if (AppState.IsSoft(Img))
            {
                <span class="badge blur" title="Soft focus — blur score @Img.BlurScore!.Value.ToString("F1") (soft at @AppState.SoftThreshold.ToString("F0") or below)">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 3v2M12 19v2M3 12h2M19 12h2" />
                    </svg>
                </span>
            }
            @if (Img.Dupe is { } d)
            {
                <span class="badge @(d.IsKeeper ? "keeper" : "dupe")" title="@DupeTitle(d)">
                    @if (d.IsKeeper)
                    {
                        <svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5" /></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="12" height="12" rx="1" /><path d="M8 8h13v13H8z" /></svg>
                    }
                </span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ImageView Img { get; set; } = null!;
    [Parameter] public int Index { get; set; }

    /// <summary>Whether this card is the grid's single tab stop. See PhotoGrid.</summary>
    [Parameter] public bool IsTabStop { get; set; }
    [Parameter] public IReadOnlyList<long> VisibleOrder { get; set; } = [];
    [Parameter] public EventCallback<ImageView> OnPreview { get; set; }

    bool Selected => AppState.Selected.Contains(Img.Id);

    AppState.NsfwBand NsfwBand => AppState.BandOf(Img);

    bool Flagged => NsfwBand is AppState.NsfwBand.Likely or AppState.NsfwBand.Unsure;

    bool HasBadges => Flagged || AppState.IsSoft(Img) || Img.Dupe is not null;

    /// <summary>Says what the model decided and what number it decided it from, in that order.
    /// The bare score used to be the whole tooltip, which told you nothing about whether it
    /// was a high one.</summary>
    string NsfwBadgeTitle =>
        $"{AppState.BandLabel(NsfwBand)} — the model scored this "
        + $"{Img.NsfwScore!.Value:F2} of 1.00 (flagged at {AppState.NsfwThreshold:F2} and above)";

    string AriaLabel
    {
        get
        {
            var bits = new List<string> { Img.FileName };
            // Only when it is actually flagged, and in words. Every scored photo used to
            // announce "NSFW 0.00", so a screen-reader user heard a content warning read out
            // over a library where nothing had been flagged at all.
            if (Flagged)
                bits.Add(NsfwBand == AppState.NsfwBand.Likely ? "likely explicit" : "explicit content, not sure");
            if (AppState.IsSoft(Img)) bits.Add("soft focus");
            if (Img.Dupe is { } d) bits.Add(d.IsKeeper ? "duplicate keeper" : "duplicate extra");
            return string.Join(", ", bits);
        }
    }

    // Reads DupeKindExtensions.Label rather than spelling the kinds out, so the three kinds are
    // named the same here, in the preview and in the folder tree's summary.
    static string DupeTitle(DupeInfo d) =>
        $"{d.Kind.Label()} duplicate group #{d.GroupId} — {(d.IsKeeper ? "keeping this one" : "extra copy")}";

    // Virtualize only re-renders an already-materialized item when its data changes; selection
    // is external state, so this component refreshes itself on AppState.Changed rather than
    // relying on cascading re-render from Home down through PhotoGrid/Virtualize.
    protected override void OnInitialized() => AppState.Changed += StateHasChanged;

    void HandleClick(MouseEventArgs e)
    {
        if (e.ShiftKey && AppState.LastClickedId is { } last)
            AppState.SelectRange(last, Img.Id, VisibleOrder);
        else
            AppState.Toggle(Img.Id);
    }

    Task HandleDoubleClick() => OnPreview.InvokeAsync(Img);

    // Arrow-key movement between cards is pure focus management and lives in interop.js;
    // this handles only the keys that change state.
    async Task HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "x":
            case "X":
            case " ":
                if (e.ShiftKey && AppState.LastClickedId is { } last)
                    AppState.SelectRange(last, Img.Id, VisibleOrder);
                else
                    AppState.Toggle(Img.Id);
                break;
            case "Enter":
                await OnPreview.InvokeAsync(Img);
                break;
        }
    }

    public void Dispose() => AppState.Changed -= StateHasChanged;
}
