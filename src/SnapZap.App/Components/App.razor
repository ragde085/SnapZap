@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using SnapZap.App.Services
@inject IWebHostEnvironment Env
@inject DependencyChecker Checker
@inject IStringLocalizer<AppResources> L
<!DOCTYPE html>
@* data-theme is omitted entirely for "system", so app.css's prefers-color-scheme fallback
   decides — rendering it here (rather than only via JS after load) is what keeps an explicit
   light/dark choice from flashing the other theme for the first frame. *@
<html lang="@CultureInfo.CurrentUICulture.Name" data-theme="@(Checker.Theme is "light" or "dark" ? Checker.Theme : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SnapZap</title>
    <base href="/" />
    @* The same .ico the .exe is built with (SnapZap.App.csproj, ApplicationIcon), so the tab
       and the taskbar show one icon. Not version-stamped: browsers refetch a favicon on their
       own schedule and the artwork does not change between builds. *@
    <link rel="icon" href="favicon.ico" sizes="any" />
    @* Version-stamped so a browser can't serve assets from a previous build. Blazor's own
       framework files are fingerprinted; these two are ours and were not. *@
    <link rel="stylesheet" href="app.css@(Version)" />
    <HeadOutlet />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />

    <div id="blazor-error-ui">
        @L["UnhandledError"]
        <a href="." class="reload">@L["Reload"]</a>
        <span class="dismiss">🗙</span>
    </div>

    @*
        Reconnection UI. Supplying an element with this id makes Blazor drive it by CSS class
        instead of building its own — the default is a white dialog inside a shadow root, which
        no stylesheet can reach, and it talks about "rejoining the server" to someone who is
        looking at a local photo app. The runtime only adds classes; showing and hiding is the
        stylesheet's job, so this is hidden by default.

        Must be plain markup in the host page, not a component: when the circuit is down there
        is nothing on the server left to render it.
    *@
    <div id="components-reconnect-modal" class="reconnect">
        <div class="reconnect-box" role="alertdialog" aria-live="assertive" aria-label="@L["ReconnectDialogLabel"]">
            <div class="reconnect-pulse" aria-hidden="true"><span></span><span></span></div>

            <h2 class="reconnect-title">@L["ReconnectTitle"]</h2>

            <p class="reconnect-line when-retrying">
                @L["ReconnectRetryingPrefix"]
                <b id="components-seconds-to-next-attempt">…</b>s
                (<b id="components-reconnect-current-attempt">1</b> @L["ReconnectRetryingOf"]
                <b id="components-reconnect-max-retries">30</b>).
            </p>

            <p class="reconnect-line when-failed">
                @L["ReconnectFailed"]
            </p>

            <p class="reconnect-line when-rejected">
                @L["ReconnectRejected"]
            </p>

            @* The question anyone actually has when a photo app drops out mid-operation. *@
            <p class="reconnect-safe">
                @L["ReconnectSafe"]
            </p>

            <div class="reconnect-actions">
                <button type="button" class="reconnect-retry">@L["TryAgain"]</button>
                <button type="button" class="reconnect-reload">@L["Reload"]</button>
            </div>
        </div>
    </div>

    <script src="_framework/blazor.web.js"></script>
    <script src="interop.js@(Version)"></script>
</body>
</html>

@code {
    /// <summary>Every asset this page version-stamps. The stamp is the newest write time
    /// across all of them, so changing any one of them busts the cache for the set. Stamping
    /// on interop.js alone used to mean a CSS-only change shipped invisibly: browsers kept
    /// serving the previous app.css, and the fix looked like it simply did not work.</summary>
    static readonly string[] StampedAssets = ["app.css", "interop.js"];

    /// <summary>
    /// Cache-buster tied to the build, so `app.css` and `interop.js` can never be served stale
    /// after an update. A stale interop.js used to blank the photo grid.
    ///
    /// Recomputed per page load rather than cached in a static: it is two file stats on a
    /// request that happens once per session, and it means editing an asset during development
    /// takes effect on refresh instead of requiring a restart.
    /// </summary>
    string Version => "?v=" + BuildStamp();

    string BuildStamp()
    {
        var version = typeof(App).Assembly.GetName().Version?.ToString() ?? "dev";
        try
        {
            // WebRootPath, not AppContext.BaseDirectory: in development wwwroot is served from
            // the project directory and is never copied to bin/, so probing beside the binary
            // found nothing and quietly fell back to the assembly version — which is constant,
            // leaving development with no cache-busting at all. WebRootPath is correct in both
            // development and a published single-file build. Assembly.Location is still avoided:
            // it is empty under single-file publish, which is how the Windows build ships.
            var root = Env.WebRootPath;
            if (string.IsNullOrEmpty(root))
                root = Path.Combine(AppContext.BaseDirectory, "wwwroot");

            var newest = StampedAssets
                .Select(a => Path.Combine(root, a))
                .Where(File.Exists)
                .Select(File.GetLastWriteTimeUtc)
                .DefaultIfEmpty()
                .Max();

            if (newest != default) return $"{version}-{newest.Ticks}";
        }
        catch { /* a version stamp must never be the thing that stops the app starting */ }
        return version;
    }
}
