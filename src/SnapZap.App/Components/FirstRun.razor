@inject IStringLocalizer<FirstRunResources> L
@*
    The one screen every new user sees, and the only one with room to say where the
    instructions live and what the app promises before it touches anything. Once a folder has
    been scanned this never shows again — the rail's Plan tab takes over.
*@
<div class="firstrun">
    <div class="firstrun-scan">
        <span class="eyeb">@L["NothingScannedYet"]</span>
        <h1>@L["PointAtFolder"]</h1>
        <p class="lede">
            @L["FirstRunLede"]
        </p>
        <ScanForm />
        <div class="hint" style="margin-top:10px">@L["EnterScansHint"]</div>
        <hr class="hr" />
        <div class="formats">
            @L["SupportedFormats"]
        </div>
        <p style="margin-top:20px"><button class="btn btn-ghost" @onclick="() => OnOpenHelp.InvokeAsync()">@L["HowSnapZapWorks"]</button></p>
    </div>
    <div class="firstrun-promises">
        <span class="eyeb">@L["TwoPromises"]</span>
        <div class="promise">
            <h4>@L["OriginalsStayPutTitle"]</h4>
            <p>
                @L["OriginalsStayPutBody"]
            </p>
        </div>
        <div class="promise">
            <h4>@L["NeverHardDeletedTitle"]</h4>
            <p>
                @L["NeverHardDeletedBody"]
            </p>
        </div>
        <div class="firstrun-shown-once">@L["ShownOnceBanner"]</div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnOpenHelp { get; set; }
}
