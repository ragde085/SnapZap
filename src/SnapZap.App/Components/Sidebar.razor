@implements IDisposable
@inject AppState AppState
@inject DependencyChecker Checker

<nav class="rail" aria-label="Tool panels">
    <button class="@Cls(Panel.Filters)"
            title="Filters"
            aria-label="Filters"
            aria-pressed="@(_panel == Panel.Filters)"
            @onclick="() => Show(Panel.Filters)">
        <svg viewBox="0 0 24 24"><path d="M4 6h16M7 12h10M10 18h4" /></svg>
        @if (AppState.HasActiveFilter)
        {
            <span class="pip" aria-hidden="true">•</span>
        }
    </button>

    <button class="@Cls(Panel.Select)"
            title="Selection"
            aria-label="Selection"
            aria-pressed="@(_panel == Panel.Select)"
            @onclick="() => Show(Panel.Select)">
        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M8 12l3 3 5-6" /></svg>
        @if (AppState.Selected.Count > 0)
        {
            <span class="pip">@Pip</span>
        }
    </button>

    <button class="@Cls(Panel.Actions)"
            title="Actions"
            aria-label="Actions"
            aria-pressed="@(_panel == Panel.Actions)"
            @onclick="() => Show(Panel.Actions)">
        <svg viewBox="0 0 24 24"><path d="M4 4h10l6 6v10H4z" /><path d="M9 13h6M12 10v6" /></svg>
    </button>

    <div class="spacer"></div>

    <button class="@Cls(Panel.Setup)"
            title="Setup"
            aria-label="Setup"
            aria-pressed="@(_panel == Panel.Setup)"
            @onclick="() => Show(Panel.Setup)">
        <svg viewBox="0 0 24 24"><path d="M12 15a3 3 0 100-6 3 3 0 000 6z" /><path d="M19.4 15a1.7 1.7 0 00.3 1.9l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.9-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1A1.7 1.7 0 008.9 19a1.7 1.7 0 00-1.9.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.9 1.7 1.7 0 00-1.5-1H3a2 2 0 110-4h.1A1.7 1.7 0 004.6 8.4a1.7 1.7 0 00-.3-1.9l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.9.3H9a1.7 1.7 0 001-1.5V3a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.9-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.9V9a1.7 1.7 0 001.5 1H21a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z" /></svg>
        @if (_missingCount > 0)
        {
            <span class="pip warn" title="@_missingCount optional feature(s) not installed">@_missingCount</span>
        }
    </button>

    <button class="@Cls(Panel.Help)"
            title="Keyboard shortcuts"
            aria-label="Keyboard shortcuts"
            aria-pressed="@(_panel == Panel.Help)"
            @onclick="() => Show(Panel.Help)">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M9.5 9a2.5 2.5 0 113.5 2.3c-.7.4-1 .9-1 1.7" /><circle cx="12" cy="17" r=".6" fill="currentColor" stroke="none" /></svg>
    </button>
</nav>

@if (_panel is not null)
{
    <aside class="flyout" aria-label="@_panel.ToString()">
        @switch (_panel)
        {
            case Panel.Filters:
                <section>
                    <h3>Filters</h3>
                    <label class="f">
                        <span class="f-label">NSFW at least <b>@(AppState.NsfwMin == 0 ? "any" : AppState.NsfwMin.ToString("F2"))</b></span>
                        <input type="range" min="0" max="1" step="0.01" @bind="AppState.NsfwMin" @bind:event="oninput" />
                    </label>
                    <label class="f">
                        <span class="f-label">Blurrier than <b>@(AppState.BlurMax == 0 ? "off" : AppState.BlurMax.ToString())</b></span>
                        <input type="range" min="0" max="300" step="5" @bind="AppState.BlurMax" @bind:event="oninput" />
                    </label>
                    <label class="f checkbox">
                        <input type="checkbox" @bind="AppState.DupesOnly" /> Duplicates only
                    </label>
                    <label class="f">
                        <span class="f-label">Folder</span>
                        <select @bind="AppState.Folder">
                            <option value="">All folders</option>
                            @foreach (var folder in AppState.Folders)
                            {
                                <option value="@folder">@ImageView.ShortFolder(folder)</option>
                            }
                        </select>
                    </label>
                    <label class="f">
                        <span class="f-label">Year</span>
                        <select @bind="AppState.Year">
                            <option value="">All years</option>
                            @foreach (var year in AppState.Years)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </label>
                    <button class="link" disabled="@(!AppState.HasActiveFilter)" @onclick="() => AppState.ClearFilters()">Clear filters</button>
                </section>
                break;

            case Panel.Select:
                <section>
                    <h3>Select</h3>
                    <div class="selcount"><b>@AppState.Selected.Count</b> selected</div>
                    <button @onclick="() => AppState.SelectAllVisible()">Everything shown</button>
                    <button @onclick="() => AppState.SelectVisibleFolder()">This folder</button>
                    <button disabled="@(AppState.DupeOf.Count == 0)" @onclick="() => AppState.SelectDupeExtras()">Duplicate extras</button>
                    <button disabled="@(AppState.Filtered().Count == 0)" @onclick="() => AppState.InvertVisibleSelection()">Invert</button>
                    <button class="link" disabled="@(AppState.Selected.Count == 0)" @onclick="() => AppState.ClearSelection()">Clear selection</button>
                    <p class="hint">Click a photo to select it. Shift-click to take a range.</p>
                </section>
                break;

            case Panel.Actions:
                <section>
                    <h3>Actions</h3>
                    <div class="selcount"><b>@AppState.Selected.Count</b> selected</div>
                    <button class="primary" disabled="@(!CanAct)" @onclick="() => OnOpenExport.InvokeAsync()">Export selected…</button>
                    <button class="danger" disabled="@(!CanAct)" @onclick="() => _confirmDelete = true">Delete selected…</button>
                    <button class="link" @onclick="() => OnOpenUndo.InvokeAsync()">History…</button>
                    <p class="hint">Deleting moves photos to the Recycle Bin. Nothing is erased, and every batch can be restored from History.</p>
                </section>
                break;

            case Panel.Setup:
                <section>
                    <h3>Setup</h3>
                    <DependencyList Items="_deps" Detailed="true" />
                    <button @onclick="Recheck">@(_checking ? "Checking…" : "Check again")</button>
                    <p class="hint">Drop a file in and press Check again — no restart needed.</p>
                </section>
                break;

            case Panel.Help:
                <section>
                    <h3>Keyboard</h3>
                    <div class="shortcuts">
                        <div><span>Move between photos</span> <kbd>↑ ↓ ← →</kbd></div>
                        <div><span>Select / deselect</span> <kbd>X</kbd></div>
                        <div><span>Extend selection</span> <kbd>Shift</kbd> <kbd>X</kbd></div>
                        <div><span>Open preview</span> <kbd>Enter</kbd></div>
                        <div><span>Select everything shown</span> <kbd>@ModKey</kbd> <kbd>A</kbd></div>
                        <div><span>Clear selection</span> <kbd>@ModKey</kbd> <kbd>D</kbd></div>
                        <div><span>Close preview or dialog</span> <kbd>Esc</kbd></div>
                        <div><span>Scan the folder</span> <kbd>Enter</kbd></div>
                    </div>
                    <p class="hint">Press <kbd>Tab</kbd> from the toolbar to reach the grid.</p>
                </section>
                break;
        }

        @if (_confirmDelete)
        {
            <div class="confirm" role="alertdialog" aria-modal="true" aria-label="Confirm delete">
                <p>Move <b>@AppState.Selected.Count</b> photo@(AppState.Selected.Count == 1 ? "" : "s") to the Recycle Bin? You can undo this.</p>
                <div class="row">
                    <button class="danger" @onclick="Delete">Move to Recycle Bin</button>
                    <button class="link" @onclick="() => _confirmDelete = false">Cancel</button>
                </div>
            </div>
        }
    </aside>
}

@code {
    enum Panel { Filters, Select, Actions, Setup, Help }

    [Parameter] public EventCallback OnOpenExport { get; set; }
    [Parameter] public EventCallback OnOpenUndo { get; set; }

    Panel? _panel = Panel.Filters;
    bool _confirmDelete;

    bool _checking;

    IReadOnlyList<DependencyInfo> _deps => Checker.Current;
    int _missingCount => Checker.MissingCount;

    async Task Recheck()
    {
        _checking = true;
        StateHasChanged();
        await Task.Delay(150);
        Checker.Check();
        _checking = false;
    }

    // The checker is a singleton shared across circuits, so a re-check may arrive off this
    // circuit's synchronization context.
    void OnDepsChanged() => InvokeAsync(StateHasChanged);

    bool CanAct => AppState.Selected.Count > 0 && !AppState.Busy;

    string Pip => AppState.Selected.Count > 99 ? "99+" : AppState.Selected.Count.ToString();

    static string ModKey => OperatingSystem.IsMacOS() ? "⌘" : "Ctrl";

    // See PhotoGrid's comment: subscribe directly since AppState changes (e.g. a card click)
    // may not touch this component's own parameters.
    protected override void OnInitialized()
    {
        AppState.Changed += StateHasChanged;
        Checker.Changed += OnDepsChanged;
    }

    public void Dispose()
    {
        AppState.Changed -= StateHasChanged;
        Checker.Changed -= OnDepsChanged;
    }

    string Cls(Panel p) => _panel == p ? "active" : "";

    void Show(Panel p)
    {
        // Clicking the active icon collapses the panel, handing the space back to the photos.
        _panel = _panel == p ? null : p;
        _confirmDelete = false;
    }

    async Task Delete()
    {
        _confirmDelete = false;
        await AppState.DeleteAsync(AppState.Selected.ToList());
    }
}
