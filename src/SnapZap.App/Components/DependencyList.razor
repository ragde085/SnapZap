@* Shared status rows, used both by the launch prompt and the Setup panel. *@
@inject IJSRuntime JS
@inject IStringLocalizer<DependencyListResources> L

@foreach (var d in Items)
{
    <div class="dep @(d.Found ? "ready" : "missing")">
        <div class="dep-head">
            <span class="dep-dot" aria-hidden="true"></span>
            <span class="dep-name">@L[d.Name]</span>
            <span class="dep-state">@(d.Found ? L["StatusReady"] : L["StatusNotInstalled"])</span>
        </div>

        @if (d.Found)
        {
            <div class="dep-body">
                <div class="dep-note">@L[d.Unlocks]</div>
                <div class="dep-path" title="@d.FoundAt">@L["UsingPathLabel", d.FoundAt]</div>
            </div>
        }
        else
        {
            <div class="dep-body">
                <div class="dep-note">@L[d.Unlocks]</div>
                <div class="dep-note quiet">@L["WithoutItLabel", L[d.WithoutIt].Value]</div>

                @if (Detailed)
                {
                    @* One command first: it downloads, checksums and installs to the right
                       folder. The manual route stays available but is folded away, because
                       reading three steps to place a file by hand is the fallback. *@
                    @if (d.Command is { } cmd)
                    {
                        <div class="dep-cmd-label">@L["RunCommandInstruction"]</div>
                        <div class="dep-cmd">
                            <code>@cmd</code>
                            <button type="button" class="dep-copy" title="@L["CopyCommandTitle"]"
                                    @onclick="() => Copy(d.Id, cmd)">
                                @(_copied == d.Id ? L["CopyButtonCopied"] : L["CopyButtonCopy"])
                            </button>
                        </div>
                        @if (d.CommandNote is { } note)
                        {
                            <div class="dep-cmd-label">@note</div>
                        }
                    }

                    @* An installed copy has no scripts folder to run anything from, so it gets
                       the one action it does have instead of a command it cannot run. *@
                    @if (d.InstallerHint is { } hint)
                    {
                        <div class="dep-cmd-label">@hint</div>
                    }

                    @* With nothing actionable above it there is nothing to be an alternative
                       to, so the manual route is the only route and starts open. *@
                    <details class="dep-manual" open="@(d.Command is null && d.InstallerHint is null)">
                        <summary>@(d.Command is null ? L["InstallManualSummaryOnly"] : L["InstallManualSummaryOr"])</summary>
                        <ol class="dep-steps">
                            @foreach (var dl in d.Downloads)
                            {
                                <li>
                                    @L["DownloadLabel"]
                                    <a href="@dl.Url" target="_blank" rel="noopener noreferrer">@dl.Label</a>
                                    @if (dl.Size is { } size)
                                    {
                                        <span class="quiet"> (@size)</span>
                                    }
                                    @* The upstream file name is never the one the app looks
                                       for, so the rename belongs with the link, not after it. *@
                                    @if (dl.SaveAs != dl.Label)
                                    {
                                        <text> @L["SaveAsInstruction"] <code>@dl.SaveAs</code></text>
                                    }
                                </li>
                            }
                            <li>
                                @(d.Downloads.Count > 1 ? L["PutBothFilesIn"] : L["PutItIn"])
                                <code class="dep-path">@d.InstallTo</code>
                            </li>
                            @if (d.ExtraStep is { } step)
                            {
                                <li>@step</li>
                            }
                        </ol>
                    </details>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<DependencyInfo> Items { get; set; } = [];

    /// <summary>Show the full install steps. Off in compact contexts.</summary>
    [Parameter] public bool Detailed { get; set; } = true;

    /// <summary>Id of the row whose command was just copied, so only that button confirms.</summary>
    string? _copied;

    async Task Copy(string id, string text)
    {
        // Clipboard access can be refused (insecure context, denied permission). Silently
        // leaving the button on "Copy" is honest — the command is still selectable above it.
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _copied = id;
        }
        catch { _copied = null; }
    }
}
