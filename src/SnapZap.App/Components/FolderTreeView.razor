@implements IDisposable
@inject AppState AppState
@inject IJSRuntime JS

@if (AppState.Tree is not { } root)
{
    <p class="hint" style="padding:11px 16px">Scan a folder to see its structure.</p>
}
else
{
    <div class="rail-search">
        <input class="input" placeholder="Find a folder…" aria-label="Find a folder"
               @bind="_query" @bind:event="oninput" />
    </div>

    @* Roving tabindex, as the ARIA tree pattern requires. Without it every folder is its own
       tab stop: a library of a thousand directories put a thousand stops between the rail and
       the photos, and the shortcut list's promise that Tab reaches the grid became a thousand
       keypresses. The stop is the selected folder, or "All folders" when nothing is chosen, so
       it always exists. *@
    <div class="tree" role="tree" aria-label="Scanned folders" @onkeydown="TreeKey">
        <button class="trow @(AppState.Folder.Length == 0 ? "on" : "")"
                role="treeitem"
                data-tree-path=""
                tabindex="@((AppState.Folder.Length == 0 || !SelectedNodeVisible) ? 0 : -1)"
                aria-selected="@(AppState.Folder.Length == 0 ? "true" : "false")"
                @onclick="() => Select(string.Empty)">
            <span class="tw" aria-hidden="true"></span>
            <span class="tname">All folders</span>
            <span class="tcount">@root.TotalCount.ToString("N0")</span>
        </button>

        @foreach (var child in root.Children)
        {
            @RenderNode(child)
        }
    </div>

    <div class="rail-legend">
        <span class="tdupes"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg></span>
        photos here are in a duplicate group ·
        <span class="tdupes clean"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg></span>
        checked, none found<br />
        <span class="tpending">●</span> some analysis hasn't reached this folder yet<br />
        ↑ ↓ move · → expand · ← collapse · Home / End jump
    </div>
}

@code {
    [Parameter] public EventCallback OnPicked { get; set; }

    readonly HashSet<string> _collapsed = new(StringComparer.Ordinal);

    string _query = "";

    protected override void OnInitialized() => AppState.Changed += StateHasChanged;
    public void Dispose() => AppState.Changed -= StateHasChanged;

    bool Searching => _query.Trim().Length > 0;

    /// <summary>
    /// Whether the folder actually selected (<see cref="AppState.Folder"/>) will render under
    /// the current search. The roving-tabindex pattern needs exactly one stop to always exist —
    /// without this, typing a search that hides the selected folder left no row at tabindex 0
    /// anywhere in the tree, and Tab could no longer reach it at all. "All folders" is the
    /// fallback stop in that case (see its own tabindex just above).
    /// </summary>
    bool SelectedNodeVisible =>
        !Searching || AppState.Folder.Length == 0 ||
        (AppState.Tree is { } root && Find(root, AppState.Folder) is { } node && SubtreeMatches(node));

    bool IsExpanded(FolderNode n) => Searching ? SubtreeMatches(n) : !_collapsed.Contains(n.Path);

    void Toggle(FolderNode n)
    {
        if (!_collapsed.Remove(n.Path)) _collapsed.Add(n.Path);
    }

    bool NameMatches(FolderNode n) =>
        n.Name.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase);

    /// <summary>Whether this node or anything beneath it matches the search — used both to
    /// decide whether a branch renders at all while searching, and to auto-expand any branch
    /// that contains a match so the user never has to open folders by hand to find one.</summary>
    bool SubtreeMatches(FolderNode n) =>
        NameMatches(n) || n.Children.Any(SubtreeMatches);

    /// <summary>
    /// The movement half of the roving-tabindex pattern: with one tab stop for the whole tree,
    /// the arrows have to be able to reach every other row. Moving focus is a DOM concern and
    /// stays in JS; expanding and collapsing is state and stays here.
    /// </summary>
    async Task TreeKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
            case "ArrowUp":
            case "Home":
            case "End":
                await JS.InvokeVoidAsync("snapzap.moveTreeFocus", e.Key);
                break;

            // Right opens a closed folder, Left closes an open one — the tree convention.
            case "ArrowRight":
            case "ArrowLeft":
                if (Searching) return;   // every matching branch is already forced open
                var path = await JS.InvokeAsync<string?>("snapzap.focusedTreePath");
                if (path is null || AppState.Tree is not { } root) return;
                if (Find(root, path) is not { HasChildren: true } node) return;
                if (e.Key == "ArrowRight" ? !IsExpanded(node) : IsExpanded(node)) Toggle(node);
                break;
        }
    }

    static FolderNode? Find(FolderNode node, string path)
    {
        if (node.Path == path) return node;
        foreach (var child in node.Children)
            if (Find(child, path) is { } hit) return hit;
        return null;
    }

    async Task Select(string path)
    {
        AppState.Folder = path;   // setter notifies and invalidates the filter cache
        await OnPicked.InvokeAsync();
    }

    Task Rescan(string path) => AppState.Busy ? Task.CompletedTask : AppState.RescanFolderAsync(path);

    static string StatusTitle(FolderNode n)
    {
        var pending = n.PendingSteps().ToList();
        return pending.Count == 0
            ? $"{n.TotalCount:N0} photos — all steps complete"
            : $"{n.TotalCount:N0} photos — {string.Join(", ", pending)}";
    }

    RenderFragment RenderNode(FolderNode node) => __builder =>
    {
        if (Searching && !SubtreeMatches(node)) return;

        var selected = AppState.Folder == node.Path;
        var expanded = IsExpanded(node);
        var pending = node.PendingSteps().Any();

        <div class="tree-branch">
            <div style="display:flex;align-items:stretch;padding-left:@(node.Depth * 11)px">
                @if (node.HasChildren)
                {
                    @* Not a tab stop of its own: the row it belongs to is the stop, and
                       ← / → expand and collapse from there. *@
                    <button style="all:unset;cursor:pointer;width:16px;flex:none;display:grid;place-items:center;color:var(--color-neutral-600)"
                            tabindex="-1"
                            aria-label="@(expanded ? "Collapse" : "Expand") @node.Name"
                            @onclick="() => Toggle(node)">
                        <span class="tw"><svg class="@(expanded ? "open" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg></span>
                    </button>
                }
                else
                {
                    <span style="width:16px;flex:none" aria-hidden="true"></span>
                }

                <button class="trow @(selected ? "on" : "")"
                        style="flex:1;min-width:0"
                        role="treeitem"
                        data-tree-path="@node.Path"
                        tabindex="@(selected ? 0 : -1)"
                        aria-selected="@(selected ? "true" : "false")"
                        aria-expanded="@(node.HasChildren ? (expanded ? "true" : "false") : null)"
                        title="@StatusTitle(node)"
                        @onclick="() => Select(node.Path)">
                    <span class="tname">@node.Name</span>
                    @* Three states, not two. An absent marker used to mean both "clean" and
                       "nobody has looked", which is the distinction the check tracks. *@
                    @if (node.InDupeGroup > 0)
                    {
                        <span class="tdupes" title="@node.InDupeGroup in duplicate groups"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg></span>
                    }
                    else if (node.TotalCount > 0 && node.DupeCheckComplete)
                    {
                        <span class="tdupes clean" title="Checked for duplicates — none found"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg></span>
                    }
                    @if (pending)
                    {
                        <span class="tpending" aria-hidden="true">●</span>
                    }
                    <span class="tcount">@node.TotalCount.ToString("N0")</span>
                </button>

                @* A sibling of the row button, not nested in it — a button can't contain another
                   button. Mouse/pointer affordance only (tabindex="-1"), same treatment as the
                   expand chevron above: the row itself is the tree's one keyboard stop. *@
                <button class="trow-action" tabindex="-1" disabled="@AppState.Busy"
                        title="Rescan @node.Name" aria-label="Rescan @node.Name"
                        @onclick="() => Rescan(node.Path)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.65-6.36" /><path d="M21 4v6h-6" /></svg>
                </button>
            </div>

            @if (expanded && node.HasChildren)
            {
                @foreach (var child in node.Children)
                {
                    @RenderNode(child)
                }
            }
        </div>
    };
}
