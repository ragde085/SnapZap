@inject AppState AppState

@if (Img is { } img)
{
    <div class="modal"
         role="dialog"
         aria-modal="true"
         aria-label="Photo preview"
         tabindex="-1"
         @ref="_modalRef"
         @onkeydown="HandleKeyDown"
         @onclick="Close">

        <button class="close" @onclick="Close" @onclick:stopPropagation="true">Close ✕</button>

        @* Stepping between photos is the whole point of opening one full size — comparing this
           shot against the next. Without it the only way through a folder is close, find, reopen. *@
        <button class="nav prev" disabled="@(Position <= 0)" aria-label="Previous photo"
                title="Previous photo (←)"
                @onclick="() => Step(-1)" @onclick:stopPropagation="true">‹</button>
        <button class="nav next" disabled="@(Position < 0 || Position >= Order.Count - 1)"
                aria-label="Next photo" title="Next photo (→)"
                @onclick="() => Step(1)" @onclick:stopPropagation="true">›</button>

        <div class="frame" @onclick:stopPropagation="true">
            <img src="@img.FullUrl" alt="@img.FileName" />
            @if (Position >= 0)
            {
                <span class="frame-pos">@(Position + 1) of @Order.Count</span>
            }
        </div>

        <div class="panel" @onclick:stopPropagation="true">
            <div>
                <div class="pk">File</div>
                <div class="pv">@img.FileName</div>
            </div>
            <div>
                <div class="pk">Folder</div>
                <div class="pv path">@img.Folder</div>
            </div>
            <div>
                <div class="pk">Dimensions</div>
                <div class="pv">@img.Dimensions · @img.SizeLabel</div>
            </div>
            <div>
                <div class="pk">Captured</div>
                <div class="pv @(img.ExifTaken is null ? "quiet" : "")">@img.CapturedLabel</div>
            </div>
            <div>
                <div class="pk">Camera</div>
                <div class="pv @(string.IsNullOrEmpty(img.ExifCamera) ? "quiet" : "")">
                    @(string.IsNullOrEmpty(img.ExifCamera) ? "not recorded" : img.ExifCamera)
                </div>
            </div>
            <div>
                <div class="pk">NSFW</div>
                @if (img.NsfwScore is { } n)
                {
                    <div class="pv @(n >= 0.5 ? "warn" : "")">@n.ToString("F3") @(n >= 0.5 ? "— flagged" : "— below threshold")</div>
                }
                else
                {
                    <div class="pv quiet">not scored</div>
                }
            </div>
            <div>
                <div class="pk">Focus</div>
                @if (img.BlurScore is { } b)
                {
                    <div class="pv @(AppState.IsSoft(img) ? "warn" : "ok")">@b.ToString("F1") — @(AppState.IsSoft(img) ? "soft" : "sharp")</div>
                }
                else
                {
                    <div class="pv quiet">not measured</div>
                }
            </div>
            <div>
                <div class="pk">Duplicates</div>
                @if (img.Dupe is { } d)
                {
                    <div class="pv accent">
                        @(d.Kind == DupeKind.Similar ? "Similar" : "Exact") group #@d.GroupId<br />
                        @(d.IsKeeper ? "keeping this one" : "extra copy")
                    </div>
                }
                else
                {
                    <div class="pv quiet">no duplicates found</div>
                }
            </div>

            <button class="@(Selected ? "" : "primary")" @onclick="() => AppState.Toggle(img.Id)">
                @(Selected ? "Deselect" : "Select this photo")
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public ImageView? Img { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Asks the host to show a different photo, so the preview stays a pure view.</summary>
    [Parameter] public EventCallback<ImageView> OnNavigate { get; set; }

    ElementReference _modalRef;
    ImageView? _focused;

    bool Selected => Img is { } img && AppState.Selected.Contains(img.Id);

    // Step through what the user is actually looking at — the filtered, sorted grid — rather
    // than the whole catalogue, so ← / → agree with the photo order on screen.
    IReadOnlyList<ImageView> Order => AppState.Filtered();

    int Position => Img is { } img
        ? Order.ToList().FindIndex(i => i.Id == img.Id)
        : -1;

    Task Step(int delta)
    {
        var at = Position;
        if (at < 0) return Task.CompletedTask;
        var next = at + delta;
        if (next < 0 || next >= Order.Count) return Task.CompletedTask;   // stop at the ends
        return OnNavigate.InvokeAsync(Order[next]);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Move focus into the dialog when it opens so Escape and tabbing work immediately.
        if (Img is not null && !ReferenceEquals(Img, _focused))
        {
            _focused = Img;
            await _modalRef.FocusAsync();
        }
        else if (Img is null)
        {
            _focused = null;
        }
    }

    Task Close() => OnClose.InvokeAsync();

    Task HandleKeyDown(KeyboardEventArgs e) => e.Key switch
    {
        "Escape" => Close(),
        "ArrowLeft" => Step(-1),
        "ArrowRight" => Step(1),
        "x" or "X" => ToggleSelection(),
        _ => Task.CompletedTask,
    };

    Task ToggleSelection()
    {
        if (Img is { } img) AppState.Toggle(img.Id);
        return Task.CompletedTask;
    }
}
