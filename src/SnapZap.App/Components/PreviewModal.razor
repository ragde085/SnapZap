@inject AppState AppState

@if (Img is { } img)
{
    <div class="modal @(AppState.PreviewDetails ? "details-open" : "")"
         role="dialog"
         aria-modal="true"
         aria-label="Photo preview"
         tabindex="-1"
         @ref="_modalRef"
         @onkeydown="HandleKeyDown"
         @onclick="Close">

        <button class="close" @onclick="Close" @onclick:stopPropagation="true">Close ✕</button>

        @* The panel covers part of the photo, so opening it is the user's call. Off by
           default: the point of opening a photo full size is to see the photo. *@
        <button class="details-toggle"
                aria-pressed="@(AppState.PreviewDetails ? "true" : "false")"
                title="Photo details (I)"
                @onclick="ToggleDetails" @onclick:stopPropagation="true">
            @(AppState.PreviewDetails ? "Hide details" : "Details")
        </button>

        @* Stepping between photos is the whole point of opening one full size — comparing this
           shot against the next. Without it the only way through a folder is close, find, reopen. *@
        <button class="nav prev" disabled="@(Position <= 0)" aria-label="Previous photo"
                title="Previous photo (←)"
                @onclick="() => Step(-1)" @onclick:stopPropagation="true">‹</button>
        <button class="nav next" disabled="@(Position < 0 || Position >= Order.Count - 1)"
                aria-label="Next photo" title="Next photo (→)"
                @onclick="() => Step(1)" @onclick:stopPropagation="true">›</button>

        <div class="frame" @onclick:stopPropagation="true">
            <img src="@img.FullUrl" alt="@img.FileName" />

            @* Selecting is the reason this screen exists, so it stays reachable whether or not
               the details panel is open — it used to live only inside the panel. *@
            <div class="frame-bar">
                @if (Position >= 0)
                {
                    <span class="frame-pos">@(Position + 1) of @Order.Count</span>
                }
                <button class="frame-select @(Selected ? "on" : "")"
                        aria-pressed="@(Selected ? "true" : "false")"
                        title="Select or deselect this photo (X)"
                        @onclick="ToggleSelection">
                    @(Selected ? "✓ Selected" : "Select")
                </button>
            </div>
        </div>

        @if (AppState.PreviewDetails)
        {
        <div class="panel" @onclick:stopPropagation="true">
            <div>
                <div class="pk">File</div>
                <div class="pv">@img.FileName</div>
            </div>
            <div>
                <div class="pk">Folder</div>
                <div class="pv path">@img.Folder</div>
            </div>
            <div>
                <div class="pk">Dimensions</div>
                <div class="pv">@img.Dimensions · @img.SizeLabel</div>
            </div>
            <div>
                <div class="pk">Captured</div>
                <div class="pv @(img.ExifTaken is null ? "quiet" : "")">@img.CapturedLabel</div>
            </div>
            <div>
                <div class="pk">Camera</div>
                <div class="pv @(string.IsNullOrEmpty(img.ExifCamera) ? "quiet" : "")">
                    @(string.IsNullOrEmpty(img.ExifCamera) ? "not recorded" : img.ExifCamera)
                </div>
            </div>
            <div>
                @* "NSFW" is jargon and every other key here is plain English. The band leads and
                   the number supports it: three decimals implied a precision the model does not
                   have (DESIGN §8 records ±0.005 reproduction error and no labelled fixtures at
                   all), and "below threshold" named a threshold shown nowhere. *@
                <div class="pk">Explicit content</div>
                @{ var band = AppState.BandOf(img); }
                <div class="pv @BandTone(band)">@AppState.BandLabel(band)</div>
                @if (img.NsfwScore is not null)
                {
                    <div class="pv-sub">@AppState.NsfwEvidence(img)</div>
                }
                else
                {
                    <div class="pv-sub">Run Score NSFW to check this photo.</div>
                }
            </div>
            <div>
                <div class="pk">Focus</div>
                @if (img.BlurScore is { } b)
                {
                    <div class="pv @(AppState.IsSoft(img) ? "warn" : "ok")">@b.ToString("F1") — @(AppState.IsSoft(img) ? "soft" : "sharp")</div>
                }
                else
                {
                    <div class="pv quiet">not measured</div>
                }
            </div>
            <div>
                <div class="pk">Duplicates</div>
                @if (img.Dupe is { } d)
                {
                    <div class="pv accent">
                        @d.Kind.Label() group #@d.GroupId<br />
                        @(d.IsKeeper ? "keeping this one" : "extra copy")
                    </div>
                }
                else
                {
                    <div class="pv quiet">no duplicates found</div>
                }
            </div>

        </div>
        }
    </div>
}

@code {
    [Parameter] public ImageView? Img { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Asks the host to show a different photo, so the preview stays a pure view.</summary>
    [Parameter] public EventCallback<ImageView> OnNavigate { get; set; }

    ElementReference _modalRef;
    bool _wasOpen;

    bool Selected => Img is { } img && AppState.Selected.Contains(img.Id);

    // Step through what the user is actually looking at — the filtered, sorted grid — rather
    // than the whole catalogue, so ← / → agree with the photo order on screen.
    IReadOnlyList<ImageView> Order => AppState.Filtered();

    int Position => Img is { } img
        ? Order.ToList().FindIndex(i => i.Id == img.Id)
        : -1;

    Task Step(int delta)
    {
        var at = Position;
        if (at < 0) return Task.CompletedTask;
        var next = at + delta;
        if (next < 0 || next >= Order.Count) return Task.CompletedTask;   // stop at the ends
        return OnNavigate.InvokeAsync(Order[next]);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only on open. Keying off the photo instead meant every ← / → step pulled focus back
        // to the dialog, so pressing Enter on "Next" moved focus off the button under it and
        // stepping through a folder by keyboard took a Tab between every photo.
        var open = Img is not null;
        if (open && !_wasOpen) await _modalRef.FocusAsync();
        _wasOpen = open;
    }

    Task Close() => OnClose.InvokeAsync();

    Task HandleKeyDown(KeyboardEventArgs e) => e.Key switch
    {
        "Escape" => Close(),
        "ArrowLeft" => Step(-1),
        "ArrowRight" => Step(1),
        "x" or "X" => ToggleSelection(),
        "i" or "I" => ToggleDetails(),
        _ => Task.CompletedTask,
    };

    static string BandTone(AppState.NsfwBand band) => band switch
    {
        AppState.NsfwBand.Likely => "warn",
        // Quieter than Likely: the card badge already distinguishes the two, and a maybe
        // shouting as loudly as a verdict is how people learn to ignore both.
        AppState.NsfwBand.Unsure => "warn dim",
        AppState.NsfwBand.Clean => "ok",
        _ => "quiet",
    };

    Task ToggleDetails()
    {
        AppState.PreviewDetails = !AppState.PreviewDetails;
        return Task.CompletedTask;
    }

    Task ToggleSelection()
    {
        if (Img is { } img) AppState.Toggle(img.Id);
        return Task.CompletedTask;
    }
}
