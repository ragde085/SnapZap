@if (Show)
{
    <div class="dlg" role="dialog" aria-modal="true" aria-label="Keyboard shortcuts"
         tabindex="-1" @ref="_ref" @onkeydown="HandleKeyDown">
        <div class="dlg-box">
            <h2>Keyboard</h2>
            <div class="shortcuts">
                <div><span>Move between photos</span> <kbd>↑ ↓ ← →</kbd></div>
                <div><span>Select / deselect</span> <kbd>X</kbd></div>
                <div><span>Extend selection</span> <kbd>Shift</kbd> <kbd>X</kbd></div>
                <div><span>Open preview</span> <kbd>Enter</kbd></div>
                <div><span>Step through the preview</span> <kbd>←</kbd> <kbd>→</kbd></div>
                <div><span>Photo details in the preview</span> <kbd>I</kbd></div>
                <div><span>Select everything shown</span> <kbd>@ModKey</kbd> <kbd>A</kbd></div>
                <div><span>Clear selection</span> <kbd>@ModKey</kbd> <kbd>D</kbd></div>
                <div><span>Close preview or dialog</span> <kbd>Esc</kbd></div>
                <div><span>Scan the folder</span> <kbd>Enter</kbd></div>
            </div>
            <div class="dlg-actions">
                <button class="primary" @onclick="Close">Close</button>
            </div>
            <p class="hint">Press <kbd>Tab</kbd> from the toolbar to reach the grid.</p>
            @* The selection lives in a singleton store while the rest of the view model is
               per-circuit, so two windows on the same library share one working set — and a
               command like "Extras" replaces it rather than adding, so one window's press
               changes what the other is about to delete. This is the only place the app
               explains how selection behaves, so it is the place to say so. *@
            <p class="hint">The selection is shared by every SnapZap window.</p>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    ElementReference _ref;
    bool _wasShown;
    bool _needsFocus;

    static string ModKey => OperatingSystem.IsMacOS() ? "⌘" : "Ctrl";

    protected override void OnParametersSet()
    {
        if (Show && !_wasShown) _needsFocus = true;
        _wasShown = Show;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Show && _needsFocus)
        {
            _needsFocus = false;
            await _ref.FocusAsync();
        }
    }

    Task Close() => OnClose.InvokeAsync();

    Task HandleKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;
}
