@inject DependencyChecker Checker
@inject IStringLocalizer<DependencyDialogResources> L

@if (Show)
{
    <div class="dlg" role="dialog" aria-modal="true" aria-label="@L["OptionalFeaturesLabel"]"
         tabindex="-1" @ref="_dlgRef" @onkeydown="HandleKeyDown">
        <div class="dlg-box">
            <h2>@Heading</h2>
            <p class="dlg-sub">
                @L["ReadyIntro"]
                @(_missing.Count == 1 ? L["UnlocksSingular"] : L["UnlocksPlural"])
            </p>

            <DependencyList Items="_missing" Detailed="true" />

            <div class="dlg-actions">
                <button class="btn btn-primary" @onclick="Recheck">@(_checking ? L["Checking"] : L["CheckAgain"])</button>
                <button class="btn btn-ghost" @onclick="Close">@L["ContinueWithoutThem"]</button>
            </div>

            <label class="f checkbox dep-suppress">
                <input type="checkbox" @bind="_suppress" /> @L["SuppressPrompt"]
            </label>
            <p class="hint">@((MarkupString)L["HintSetup"].Value)</p>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    IReadOnlyList<DependencyInfo> _missing = [];

    string Heading => _missing.Count == 1 ? L["HeadingSingular"] : L["HeadingPlural", _missing.Count];
    bool _suppress;
    bool _checking;
    bool _wasShown;
    bool _needsFocus;
    ElementReference _dlgRef;

    protected override void OnParametersSet()
    {
        if (Show && !_wasShown)
        {
            _missing = Checker.Current.Where(d => !d.Found).ToList();
            _suppress = Checker.PromptSuppressed;
            _needsFocus = true;
        }
        _wasShown = Show;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Show && _needsFocus)
        {
            _needsFocus = false;
            await _dlgRef.FocusAsync();
        }
    }

    async Task Recheck()
    {
        _checking = true;
        StateHasChanged();
        // Give the spinner a frame; detection itself is a couple of file probes.
        await Task.Delay(150);

        _missing = Checker.Check().Where(d => !d.Found).ToList();
        _checking = false;

        // Everything resolved — nothing left to prompt about.
        if (_missing.Count == 0) await Close();
    }

    async Task Close()
    {
        Checker.PromptSuppressed = _suppress;
        await OnClose.InvokeAsync();
    }

    Task HandleKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;
}
